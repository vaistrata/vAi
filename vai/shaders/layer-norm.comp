/*=============================================================================
 layer-norm.comp: layer normalization over the feature axis
     O[i, j] = (I[i, j] - mean(I[i, :])) * rsqrt(var(I[i, :]) + eps) * scale[j] + shift[j] (+ R[i, j])

 A workgroup normalizes one row: its wgSize threads accumulate strided
 partials of the shifted 1-pass statistics (Chan–Golub–LeVeque: with
 s = I[row, 0], sum = Σ(x−s) and sumSq = Σ(x−s)² give mean = s + sum/F and
 Σ(x−mean)² = sumSq − sum²/F), reduce them, then normalize + affine in
 parallel. 2-pass-grade precision without Welford's per-element divide and
 loop-carried dependence.

 - O (typeO), I (typeI), scale / shift (typeW) are fp32 or fp16 via same-binding
   buffer aliases; accumulation is always fp32.
 - reduction: subgroupAdd two-level (sgReduce == 1, host pins the
   subgroup size) or shared-memory tree fallback.
 - aligned == 1 (typeO == typeI == fp32, F % 4 == 0): direct vec4 I/O loads.
 - Dispatch (host): one workgroup per row, rows folded over grid x/y as
   .dispatch(gridX, ceil(batchSize / gridX)) -- grid x alone caps at 65535
   on some devices (Intel), below a long prefill's row count.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#include "common/spec_constants.h"

layout(constant_id = 0) const uint wgSize   = 256;             // threads per workgroup (host lnTuning())
layout(constant_id = 1) const uint sgReduce = 0;               // 1: subgroupAdd reduction, 0: shared tree
layout(constant_id = 2) const uint hasShift  = 1;               // 0: no shift, 1: shift[F]
layout(constant_id = 3) const uint hasResidual = 0;            // 1: residual R of in0's shape and dtype
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;     // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;     // I (input) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0;     // scale / shift dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 0;  // 1: vec4 I/O loads

layout(local_size_x_id = 0) in;

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_4F32  { vec4 bufferO_4f32[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_4F32  { vec4 bufferI_4f32[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) restrict readonly buffer SCALE_BUF_F32 { float bufferScale_f32[]; };
layout(set = 0, binding = 2) restrict readonly buffer SCALE_BUF_F16 { float16_t bufferScale_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 3) restrict readonly buffer SHIFT_BUF_F32 { float bufferShift_f32[]; };
layout(set = 0, binding = 3) restrict readonly buffer SHIFT_BUF_F16 { float16_t bufferShift_f16[]; };
layout(set = 0, binding = 4) restrict readonly buffer RES_BUF_F32 { float bufferRes_f32[]; };
layout(set = 0, binding = 4) restrict readonly buffer RES_BUF_F16 { float16_t bufferRes_f16[]; };
layout(set = 0, binding = 4) restrict readonly buffer RES_BUF_4F32 { vec4 bufferRes_4f32[]; };

layout(push_constant) uniform PushConstants {
    uint batchSize;
    uint featSize;
    float eps;
    uint gridX;     // dispatch width -- row = y * gridX + x
};

float readI(uint i)     { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
float readScale(uint j) { return (typeW == DTYPE_F32) ? bufferScale_f32[j] : float(bufferScale_f16[j]); }
float readShift(uint j)  { return (hasShift == 0u) ? 0.0 : ((typeW == DTYPE_F32) ? bufferShift_f32[j] : float(bufferShift_f16[j])); }
float readResidual(uint i) { return (hasResidual == 0u) ? 0.0 : ((typeI == DTYPE_F32) ? bufferRes_f32[i] : float(bufferRes_f16[i])); }
vec4 readResidual4(uint i4) { return (hasResidual == 0u) ? vec4(0.0) : bufferRes_4f32[i4]; }   // aligned: fp32
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// Per-thread partial sums (spec-constant-sized) — with sgReduce == 1 only
// the first gl_NumSubgroups (<= wgSize / sg) slots are used.
shared float sSum  [wgSize];
shared float sSumSq[wgSize];

// Final reduced statistics, broadcast to all threads in the workgroup
shared float gMean;
shared float gInvStd;

// Phase 1: per-thread 1-pass accumulation over a strided slice (independent
// accumulators — ILP). Returns (Σ(x−s), Σ(x−s)²) of this thread's elements.
vec2 accumAligned(uint base, uint F, float sh)
{
    // vec4 loads — typeI == fp32 && F % 4 == 0 (host-guaranteed)
    uint F4    = F / 4u;
    uint base4 = base / 4u;
    vec4 sh4 = vec4(sh);
    vec4 s4  = vec4(0.0);
    vec4 q4  = vec4(0.0);
    for (uint j = gl_LocalInvocationID.x; j < F4; j += wgSize)
    {
        vec4 d = bufferI_4f32[base4 + j] - sh4;
        s4 += d;
        q4 += d * d;
    }
    return vec2(s4.x + s4.y + s4.z + s4.w, q4.x + q4.y + q4.z + q4.w);
}

vec2 accumScalar(uint base, uint F, float sh)
{
    float sum   = 0.0;
    float sumSq = 0.0;
    for (uint j = gl_LocalInvocationID.x; j < F; j += wgSize)
    {
        float d = readI(base + j) - sh;
        sum   += d;
        sumSq += d * d;
    }
    return vec2(sum, sumSq);
}

// Phase 3: normalize + affine over the same strided slice
void normalizeAligned(uint base, uint F, float mean, float invStd)
{
    uint F4    = F / 4u;
    uint base4 = base / 4u;
    for (uint j = gl_LocalInvocationID.x; j < F4; j += wgSize)
    {
        uint c = 4u * j;
        vec4 x4 = bufferI_4f32[base4 + j];
        vec4 scale4 = vec4(readScale(c), readScale(c + 1u), readScale(c + 2u), readScale(c + 3u));
        vec4 shift4 = vec4(readShift(c), readShift(c + 1u), readShift(c + 2u), readShift(c + 3u));
        bufferO_4f32[base4 + j] = (x4 - vec4(mean)) * invStd * scale4 + shift4 + readResidual4(base4 + j);
    }
}

void normalizeScalar(uint base, uint F, float mean, float invStd)
{
    for (uint j = gl_LocalInvocationID.x; j < F; j += wgSize)
        writeO(base + j, (readI(base + j) - mean) * invStd * readScale(j) + readShift(j) + readResidual(base + j));
}

void main()
{
    uint row = gl_WorkGroupID.y * gridX + gl_WorkGroupID.x;
    if (row >= batchSize) return;

    uint tid  = gl_LocalInvocationID.x;
    uint F    = featSize;
    uint base = row * F;

    // shift = the row's first element — keeps the accumulated sums at spread
    // (σ) scale instead of mean scale.
    float sh = readI(base);

    // Phase 1: shifted 1-pass accumulation (aligned: vec4 loads)
    vec2 partial = (aligned != 0u) ? accumAligned(base, F, sh)
                                   : accumScalar(base, F, sh);
    float sum   = partial.x;
    float sumSq = partial.y;

    // Phase 2: reduction — subgroupAdd two-level or shared-memory tree (spec-selected)
    if (sgReduce != 0u)
    {
        sum   = subgroupAdd(sum);
        sumSq = subgroupAdd(sumSq);
        if (subgroupElect())
        {
            sSum  [gl_SubgroupID] = sum;
            sSumSq[gl_SubgroupID] = sumSq;
        }
        barrier();
        if (tid == 0u)
        {
            float s = 0.0, q = 0.0;
            for (uint i = 0u; i < gl_NumSubgroups; ++i)
            {
                s += sSum[i];
                q += sSumSq[i];
            }
            sSum[0] = s;
            sSumSq[0] = q;
        }
        barrier();
    }
    else
    {
        sSum  [tid] = sum;
        sSumSq[tid] = sumSq;
        barrier();
        for (uint stride = wgSize / 2u; stride > 0u; stride >>= 1)
        {
            if (tid < stride)
            {
                sSum  [tid] += sSum  [tid + stride];
                sSumSq[tid] += sSumSq[tid + stride];
            }
            barrier();
        }
    }

    if (tid == 0u)
    {
        float s = sSum[0];
        // Shifted identity: Σ(x−mean)² = Σ(x−s)² − (Σ(x−s))²/F; fp32 rounding
        // can drive it slightly negative, so clamp to 0.
        float m2 = max(sSumSq[0] - s * s / float(F), 0.0);
        gMean   = sh + s / float(F);
        gInvStd = inversesqrt(m2 / float(F) + eps);
    }
    barrier();

    float mean_g   = gMean;
    float invStd_g = gInvStd;

    // Phase 3: normalize + affine, parallel over features
    if (aligned != 0u) normalizeAligned(base, F, mean_g, invStd_g);
    else               normalizeScalar(base, F, mean_g, invStd_g);
}
