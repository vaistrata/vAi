/*=============================================================================
 attention-fa-reduce.comp: split-K (FlashDecoding) reduce
     (ported from the ggml/llama.cpp Vulkan flash_attn_split_k_reduce.comp)

     One workgroup per output row; the splits' partial states (m_k, l_k, acc_k)
     merge as
         mMax = max_k m_k
         L    = sum_k exp(m_k - mMax) * l_k
         O[d] = sum_k exp(m_k - mMax) * acc_k[d] / L
     Empty splits carry (m=-1e30, l=0, acc=0) and contribute nothing;
     QK_MAX_OFFSET is baked into every split's m identically, so it cancels.
     skipEmptySplits (spec 2, the FA kernels' flag of the same name): empty splits left
     early with (m=-1e30, l=-1) and no acc. The busy splits are a prefix (and
     maybe the last split); the O fold runs over that prefix alone.

 Threads: threadsPerRow (spec 0, sized by the host for the split count). The (m, l)
 passes take one split per thread; the O fold splits the threads into lanes of
 Dh / 4 columns that take the splits round-robin and meet once in shared memory.
 NOTE (vs llama.cpp): ggml keeps the partials in-place in an extended dst
 buffer; vai stores them in two temporaries with the (m, l) pair layout.

 Dispatch (host): (B * Tq * Hq, 1, 1), threadsPerRow threads (spec 0)
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = threadsPerRow (same SpecId)

layout(constant_id = 0) const uint threadsPerRow = 256;     // threads of the one workgroup a row gets: a power of two, >= Dh / 4 (host: reduceThreadsPerRow)
layout(constant_id = 2) const uint skipEmptySplits = 0;     // 1: marked idle splits (l < 0) wrote no acc (the FA kernels' skipEmptySplits)
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype

layout(set = 0, binding = 0) buffer O_BUF_F32  { vec4 bufferO_f32[]; };      // attention O [B, Tq, Hq, Dh], vec4 units
layout(set = 0, binding = 0) buffer O_BUF_F16  { f16vec4 bufferO_f16[]; };
layout(set = 0, binding = 1) buffer PO_BUF     { vec4 partialO[];  };        // [B*Tq*Hq, kCount, Dh / 4]
layout(set = 0, binding = 2) buffer PML_BUF    { float partialML[]; };       // [B*Tq*Hq, kCount, (m, l)]

layout(push_constant) uniform PushConstants {
    uint Dh;
    uint kCount;
};

void writeO4(uint i, vec4 v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = f16vec4(v); }

#define NEG_INF  uintBitsToFloat(0xFF800000u)
#define FLT_MAX  uintBitsToFloat(0x7F7FFFFFu)

// Per-subgroup slots (subgroups of 8 at the least) and the lanes' O partials.
shared float s_m[threadsPerRow / 8u];
shared uint  s_i[threadsPerRow / 8u];
shared float s_l[threadsPerRow / 8u];
shared vec4  s_o[threadsPerRow];          // [lane][Dh / 4]

void main()
{
    const uint row    = gl_WorkGroupID.x;   // qTok * Hq + qHead
    const uint tid    = gl_LocalInvocationID.x;
    const uint mlBase = row * kCount * 2u;
    const uint DH4    = Dh / 4u;
    const uint sgId   = gl_SubgroupID, nSg = gl_NumSubgroups;

    // (1) Row max across splits (skipEmptySplits: and the first marked split), one
    // split per thread, then the subgroups meet.
    float mPart    = NEG_INF;
    uint  idlePart = kCount;
    for (uint k = tid; k < kCount; k += threadsPerRow)
    {
        mPart = max(mPart, partialML[mlBase + k * 2u]);
        if (skipEmptySplits != 0u && partialML[mlBase + k * 2u + 1u] < 0.0)
            idlePart = min(idlePart, k);
    }
    mPart    = subgroupMax(mPart);
    idlePart = subgroupMin(idlePart);
    if (gl_SubgroupInvocationID == 0u) { s_m[sgId] = mPart; s_i[sgId] = idlePart; }
    barrier();
    float mMax      = NEG_INF;
    uint  firstIdle = kCount;
    for (uint s = 0u; s < nSg; ++s) { mMax = max(mMax, s_m[s]); firstIdle = min(firstIdle, s_i[s]); }

    // (2) L = sum_k exp(m_k - mMax) * l_k (an idle split's l = -1 meets a weight of 0).
    float lPart = 0.0;
    for (uint k = tid; k < kCount; k += threadsPerRow)
        lPart += exp(partialML[mlBase + k * 2u] - mMax) * partialML[mlBase + k * 2u + 1u];
    lPart = subgroupAdd(lPart);
    if (gl_SubgroupInvocationID == 0u) s_l[sgId] = lPart;
    barrier();
    float L = 0.0;
    for (uint s = 0u; s < nSg; ++s) L += s_l[s];
    L = (L == 0.0) ? 0.0 : (1.0 / L);

    // (3) Fold the splits' acc: lane = tid / DH4 takes splits lane, lane + lanes, ...
    // over the busy prefix, four in flight; the lanes meet in s_o.
    const uint lanes = threadsPerRow / DH4;
    const uint kEnd  = (skipEmptySplits != 0u) ? firstIdle : kCount;
    const bool lastBusy = skipEmptySplits != 0u && kEnd + 1u < kCount && partialML[mlBase + (kCount - 1u) * 2u + 1u] >= 0.0;
    if (tid < lanes * DH4)
    {
        const uint lane = tid / DH4, v = tid % DH4;
        vec4 o0 = vec4(0.0), o1 = vec4(0.0), o2 = vec4(0.0), o3 = vec4(0.0);
        uint k = lane;
        for (; k + 3u * lanes < kEnd; k += 4u * lanes)
        {
            o0 += exp(partialML[mlBase + (k             ) * 2u] - mMax) * partialO[(row * kCount + k             ) * DH4 + v];
            o1 += exp(partialML[mlBase + (k +       lanes) * 2u] - mMax) * partialO[(row * kCount + k +       lanes) * DH4 + v];
            o2 += exp(partialML[mlBase + (k +  2u * lanes) * 2u] - mMax) * partialO[(row * kCount + k +  2u * lanes) * DH4 + v];
            o3 += exp(partialML[mlBase + (k +  3u * lanes) * 2u] - mMax) * partialO[(row * kCount + k +  3u * lanes) * DH4 + v];
        }
        for (; k < kEnd; k += lanes)
            o0 += exp(partialML[mlBase + k * 2u] - mMax) * partialO[(row * kCount + k) * DH4 + v];
        // skipEmptySplits: the last split past the prefix (appendBeforeSweep's token), when busy.
        if (lastBusy && lane == 0u)
            o0 += exp(partialML[mlBase + (kCount - 1u) * 2u] - mMax) * partialO[(row * kCount + kCount - 1u) * DH4 + v];
        s_o[tid] = (o0 + o1) + (o2 + o3);
    }
    barrier();
    if (tid < DH4)
    {
        vec4 o = vec4(0.0);
        for (uint lane = 0u; lane < lanes; ++lane) o += s_o[lane * DH4 + tid];
        writeO4(row * DH4 + tid, clamp(o * L, -FLT_MAX, FLT_MAX));
    }
}
