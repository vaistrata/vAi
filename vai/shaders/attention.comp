/*=============================================================================
 attention.comp (separate Q/K/V, GQA):
     KV cache update + causal scaled dot-product attention.
     1) append new K, V tokens to the K / V cache (for future dispatches)
     2) O[tq, hq, dh] = sum_j softmax(Q[hq, tq] · K_pos(hq/groupSize, j) * scale)[j] * V_pos(hq/groupSize, j, dh)

 O is token-major [B, Tq, Hq, Dh] (NOT head-major [B, Hq, Tq, Dh])
 so the merge back to [B, Tq, Hq*Dh] is a reshape and needs no permute pass; this
 also matches the llama.cpp flash-attention store layout the FA path ports.

 - O (typeO), Q (typeI), the K / V inputs (typeKV) and the K / V cache (typeCache)
   are fp32 or fp16, accessed through same-binding buffer aliases. Cache writes
   are element-owned (one lane per element), so they are race-free.
 - one thread per output head-dim element; dispatch (Dh, Tq, B*Hq).
   x, y and z are all taken, so the sequence folds into z with the head.

 Fusion trick: new positions (j >= kvCacheCount) are served from the K, V
 inputs, never from the freshly-written cache, so cache writes carry no read
 dependency inside this dispatch.

 The mask's span bounds a query from below (keyStart, a sliding window); it only
 moves the sweep's lower bound.

 Ring cache (spec kvCacheRing): the cache keeps the last Tmax positions,
 position p at row p % Tmax. The host holds Tmax to at least span + Tkv - 1, so
 the append overwrites only positions below every query's span.

 kvCaching == 0 drops step 1: the cache and counter descriptors are null, so
 kvCacheCount reads back as 0 and the fusion trick serves the whole sweep
 from the K, V inputs.

 The K, V inputs carry Tkv rows (0 = the cache alone), aligned with the Tq
 queries at their ends; Tkv > Tq rows append Tq apart across the query
 threads.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
#include "common/spec_constants.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint kvCacheRing = 0;   // 1: the cache keeps the last Tmax positions, p at row p % Tmax
layout(constant_id = 1) const uint typeI      = 0;    // Q input dtype
layout(constant_id = 2) const uint typeCache  = 0;    // K / V cache dtype
layout(constant_id = 3) const uint kvCaching  = 1;    // 0: skip the append; the cache bindings are null
layout(constant_id = 4) const uint typeKV     = 0;    // K / V input dtype
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype

layout(set = 0, binding = 0) buffer O_BUF_F32      { float bufferO_f32[]; };   // attention O [B, Tq, Hq, Dh]
layout(set = 0, binding = 0) buffer O_BUF_F16      { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer Q_BUF_F32      { float bufferQ_f32[]; };   // query Q [B, Hq, Tq, Dh]
layout(set = 0, binding = 1) buffer Q_BUF_F16      { float16_t bufferQ_f16[]; };
layout(set = 0, binding = 2) buffer K_BUF_F32      { float bufferK_f32[]; };   // key   K [B, Hkv, Tkv, Dh] (new tokens)
layout(set = 0, binding = 2) buffer K_BUF_F16      { float16_t bufferK_f16[]; };
layout(set = 0, binding = 3) buffer V_BUF_F32      { float bufferV_f32[]; };   // value V [B, Hkv, Tkv, Dh] (new tokens)
layout(set = 0, binding = 3) buffer V_BUF_F16      { float16_t bufferV_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 4) buffer KCACHE_BUF_F32 { float bufferKCache_f32[]; };   // K cache [B, Hkv, Tmax, Dh]
layout(set = 0, binding = 4) buffer KCACHE_BUF_F16 { float16_t bufferKCache_f16[]; };
layout(set = 0, binding = 5) buffer VCACHE_BUF_F32 { float bufferVCache_f32[]; };   // V cache [B, Hkv, Tmax, Dh]
layout(set = 0, binding = 5) buffer VCACHE_BUF_F16 { float16_t bufferVCache_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 6) uniform UB            { uint kvCacheCount; };

layout(push_constant) uniform PushConstants {
    uint Dh;
    uint Hq;
    uint groupSize;   // Hq / Hkv: query heads sharing one KV head
    uint Tq;
    uint Tkv;         // K / V input rows
    uint Tmax;
    float scale;
};

#define CAUSAL_MASK_BINDING 7
#include "common/causal_mask.h"

// newTokenEnd among the Tkv new keys, queries and keys aligned at their ends:
// query t sits at key t + Tkv - Tq.
uint keyEnd(uint t)
{
    return uint(max(int(newTokenEnd(t) + Tkv) - int(Tq), 0));
}

// Query t's own key position, in the same alignment keyEnd uses.
uint keyPos(uint t)
{
    return kvCacheCount + uint(max(int(t + Tkv) - int(Tq), 0));
}

// The cache row that holds position p.
uint cacheRow(uint p)
{
    return (kvCacheRing != 0u) ? p % Tmax : p;
}

float readQ(uint i)      { return (typeI == DTYPE_F32) ? bufferQ_f32[i] : float(bufferQ_f16[i]); }
float readK(uint i)      { return (typeKV == DTYPE_F32) ? bufferK_f32[i] : float(bufferK_f16[i]); }
float readV(uint i)      { return (typeKV == DTYPE_F32) ? bufferV_f32[i] : float(bufferV_f16[i]); }
float readKCache(uint i) { return (typeCache == DTYPE_F32) ? bufferKCache_f32[i] : float(bufferKCache_f16[i]); }
float readVCache(uint i) { return (typeCache == DTYPE_F32) ? bufferVCache_f32[i] : float(bufferVCache_f16[i]); }
void writeO(uint i, float v)      { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }
void writeKCache(uint i, float v) { if (typeCache == DTYPE_F32) bufferKCache_f32[i] = v; else bufferKCache_f16[i] = float16_t(v); }
void writeVCache(uint i, float v) { if (typeCache == DTYPE_F32) bufferVCache_f32[i] = v; else bufferVCache_f16[i] = float16_t(v); }


// One online-softmax accumulation step (first iteration lPrev = 0 -> acc*0 = 0;
// lNew = expCurr > 0 always, so no division by zero).
void accumulate(inout float mPrev, inout float lPrev, inout float acc,
                float qk, float v)
{
    float mNew    = max(mPrev, qk);
    float expPrev = exp(mPrev - mNew);
    float expCurr = exp(qk - mNew);
    float lNew    = lPrev * expPrev + expCurr;
    acc   = (acc * lPrev * expPrev + expCurr * v) / lNew;
    mPrev = mNew;
    lPrev = lNew;
}

void main()
{
    uint dh = gl_GlobalInvocationID.x;
    uint tq = gl_GlobalInvocationID.y;
    // x and y are taken, so the sequence and the head share z. Every offset
    // below reads that flat index the way it read hq before; only the store
    // parts it back, and with one sequence it is hq itself.
    uint z = gl_GlobalInvocationID.z;          // = b * Hq + hq
    if (tq >= Tq || dh >= Dh) return;

    uint kvHead      = z / groupSize;          // = b * Hkv + hq / groupSize
    uint kvCacheBase = kvHead * Tmax  * Dh;
    uint kvInputBase = kvHead * Tkv * Dh;
    uint qRowOffset  = (z * Tq + tq) * Dh;

    // (A) Persist new K, V into the cache for future dispatches. Element-owned:
    //     one lane per element. No barrier(): attention reads new tokens from
    //     the inputs, not these fresh slots.
    //     Row tq, then (cross-attention, Tkv > Tq) every Tq-th row after it.
    if (kvCaching != 0u && z % groupSize == 0u)
    {
        for (uint t = tq; t < Tkv; t += Tq)
        {
            uint srcIdx = kvInputBase + t * Dh + dh;
            uint dstIdx = kvCacheBase + cacheRow(kvCacheCount + t) * Dh + dh;
            writeKCache(dstIdx, readK(srcIdx));
            writeVCache(dstIdx, readV(srcIdx));
        }
    }

    // (B) Online-softmax attention over the range this query owns.
    float mPrev = -1e30;
    float lPrev = 0.0;
    float acc   = 0.0;

    // The oldest token my query may attend to.
    uint sweepPos = keyStart(keyPos(tq));

    // Phase 1: cached tokens  j ∈ [sweepPos, kvCacheCount)
    for (uint j = sweepPos; j < kvCacheCount; ++j)
    {
        uint kBase = kvCacheBase + cacheRow(j) * Dh;
        float qk = 0.0;
        for (uint dh_ = 0u; dh_ < Dh; ++dh_)
            qk += readQ(qRowOffset + dh_) * readKCache(kBase + dh_);
        accumulate(mPrev, lPrev, acc, qk * scale, readVCache(kBase + dh));
    }

    // Phase 2: this dispatch's new tokens  j ∈ [sweepPos - cached, newEnd)
    uint newEnd = keyEnd(tq);

    for (uint j = max(sweepPos, kvCacheCount) - kvCacheCount; j < newEnd; ++j)
    {
        uint kBase = kvInputBase + j * Dh;
        float qk = 0.0;
        for (uint dh_ = 0u; dh_ < Dh; ++dh_)
            qk += readQ(qRowOffset + dh_) * readK(kBase + dh_);
        accumulate(mPrev, lPrev, acc, qk * scale, readV(kBase + dh));
    }

    uint b  = z / Hq;
    uint hq = z - b * Hq;
    writeO(((b * Tq + tq) * Hq + hq) * Dh + dh, acc);   // token-major store
}
