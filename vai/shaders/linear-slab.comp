/*=============================================================================
 linear-slab.comp: slab (1D) output decomposition, for M <= 8
     (ported from the ggml/llama.cpp Vulkan mul_mat_vec kernel)

     O[j, n] = s * epilogue( sum_k I[j, k] * W[n, k] + B[j, n] ) + R[j, n]    residualOrder 0
     O[j, n] = s * epilogue( sum_k I[j, k] * W[n, k] + B[j, n] + R[j, n] )    residualOrder 1

 A workgroup produces the M x wgN outputs at N positions [n0, n0 + wgN): its
 wgSize threads split K, so each ends up with a partial of every output.
 subgroupAdd sums those per subgroup; a workgroup of several subgroups
 (wgSize > sgSize) folds the per-subgroup sums through shared memory
 (ggml SUBGROUP / HYBRID).

 - O [M, N] (typeO), I [M, K] (typeI), W [N, K] / bias [N] (typeW) are fp32
   or fp16 via same-binding buffer aliases; accumulation is fp32.
 - bias B (typeW) is [N] or [M, N]; residual R
   (typeO) is [M, N]. A [M, N] operand may be shorter rows that repeat over M
   (biasElems / residualElems).
 - M is a spec constant, not a push constant: one W stream feeds M dot chains.
 - aligned == 1 (K % 4 == 0): direct vec4 loads, no masking.
   aligned == 0: scalar-composed loads, K-tail masked on the last iteration.
 - wgN == 2 for fp16 W. An N that is not a multiple of wgN leaves a short
   last group, which main() hands a runtime count.
 - Dispatch (host): (ceil(N / wgN), 1, 1); an N past the X-grid limit folds
   into z (ggml groups_z split) and main() re-linearizes.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require
#include "common/activation.h"
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = wgSize (same SpecId)

layout(constant_id = 0) const uint wgSize = 128;  // threads per workgroup (= local_size_x)
layout(constant_id = 1) const uint sgSize = 32;   // pinned subgroup size (host requiredSubgroupSize)
layout(constant_id = 2) const uint M      = 1;    // flattened batch = this workgroup's M extent (ggml NUM_COLS)
layout(constant_id = 3) const uint wgN    = 1;    // N positions per workgroup (ggml NUM_ROWS)
layout(constant_id = 4) const uint hasBias = 0;        // 1: bias[N] or bias[M, N]
layout(constant_id = 5) const uint biasElems = 0;      // 0 covers O; else the bias block repeats
layout(constant_id = 6) const uint hasResidual = 0;    // 1: residual[M, N]
layout(constant_id = 7) const uint residualElems = 0;  // 0: the residual covers O; else it repeats
layout(constant_id = 8) const uint residualOrder = 0;  // 0: after the epilogue, 1: before it

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0;  // W (weight) and bias dtype
layout(constant_id = SPEC_ID_ALIGNED) const uint aligned = 1;  // 1: K % 4 == 0, 0: masked K tail

const uint K_PER_ITER = 4;    // k elements per thread per iteration (ggml non-quant width)

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32  { float bufferO_f32[]; };
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16  { float16_t bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly buffer I_BUF_F32   { float bufferI_f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F32  { vec4 bufferI_4f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_F16   { float16_t bufferI_f16[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F16  { f16vec4 bufferI_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) readonly buffer W_BUF_F32   { float bufferW_f32[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_4F32  { vec4 bufferW_4f32[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_F16   { float16_t bufferW_f16[]; };
layout(set = 0, binding = 2) readonly buffer W_BUF_4F16  { f16vec4 bufferW_4f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 3) readonly buffer BIAS_BUF_32 { float bufferBias_f32[]; };
layout(set = 0, binding = 3) readonly buffer BIAS_BUF_16 { float16_t bufferBias_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 4) readonly buffer R_BUF_F32 { float bufferR_f32[]; };
layout(set = 0, binding = 4) readonly buffer R_BUF_F16 { float16_t bufferR_f16[]; };

layout(push_constant) uniform PushConstants {
    uint K;
    uint N;
    float scalarScale;   // s
};

float readI(uint i)    { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
vec4  readI4(uint i4)  { return (typeI == DTYPE_F32) ? bufferI_4f32[i4] : vec4(bufferI_4f16[i4]); }
float readW(uint i)    { return (typeW == DTYPE_F32) ? bufferW_f32[i] : float(bufferW_f16[i]); }
vec4  readW4(uint i4)  { return (typeW == DTYPE_F32) ? bufferW_4f32[i4] : vec4(bufferW_4f16[i4]); }
// Each operand's element for output index i (row-major over [M, N]).
uint biasIdx(uint i)     { return (biasElems == 0u) ? i : i % biasElems; }
uint residualIdx(uint i) { return (residualElems == 0u) ? i : i % residualElems; }
float readBias(uint i) { return (hasBias == 0u) ? 0.0 : ((typeW == DTYPE_F32) ? bufferBias_f32[biasIdx(i)] : float(bufferBias_f16[biasIdx(i)])); }
float readR(uint i)    { return (hasResidual == 0u) ? 0.0 : ((typeO == DTYPE_F32) ? bufferR_f32[residualIdx(i)] : float(bufferR_f16[residualIdx(i)])); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// One K_PER_ITER-wide read at row-relative offset k0: a direct vec4 when
// aligned, scalar-composed otherwise. The K-tail mask runs on the last
// iteration only (ggml load_b OOB pattern); element 0 is always in range
// by the numIters trip-count condition.
vec4 readI4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readI4((rowBase + k0) >> 2);
    return vec4(
        readI(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readI(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readI(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readI(rowBase + k0 + 3));
}

vec4 readW4Masked(uint rowBase, uint k0, bool lastIter)
{
    if (aligned != 0u)
        return readW4((rowBase + k0) >> 2);
    return vec4(
        readW(rowBase + k0),
        (lastIter && k0 + 1 >= K) ? 0.0 : readW(rowBase + k0 + 1),
        (lastIter && k0 + 2 >= K) ? 0.0 : readW(rowBase + k0 + 2),
        (lastIter && k0 + 3 >= K) ? 0.0 : readW(rowBase + k0 + 3));
}

// One iteration: this thread's K_PER_ITER chunk dotted for every
// (batch entry, N position) pair. W re-loads per batch entry are CSE'd by
// the compiler — one input load feeds nCount chains, unrolled over M.
void dotKChunk(inout float sums[M][wgN],
               uint n0, uint nCount, uint tid, uint it, bool lastIter)
{
    const uint k0 = K_PER_ITER * (it * wgSize + tid);

    [[unroll]] for (uint j = 0; j < M; j++)
    {
        vec4 iv = readI4Masked(j * K, k0, lastIter);

        uint wRow = n0 * K;
        [[unroll]] for (uint n = 0; n < nCount; n++)
        {
            sums[j][n] += dot(readW4Masked(wRow, k0, lastIter), iv);
            wRow += K;
        }
    }
}

// Per-(batch entry, N position, subgroup) partials for the cross-subgroup fold
// below. Third dim is the subgroup count, which gl_SubgroupID indexes exactly:
// the pipeline pins the subgroup size, so wgSize / sgSize is what the device
// launches. (ggml sizes the same array by the full workgroup instead, because
// its no-subgroup reduction path gives every thread a slot.)
shared float tmpsh[M][wgN][wgSize / sgSize];

// The nCount outputs starting at N position n0: accumulate this thread's K
// chunks, fold the workgroup's partials, and store with bias / epilogue / the
// residual applied. nCount is wgN for full groups and a runtime remainder for
// the short last one (see main).
void computeOutputs(const uint n0, const uint nCount)
{
    const uint tid = gl_LocalInvocationID.x;

    float sums[M][wgN];
    [[unroll]] for (uint j = 0; j < M; j++)
        [[unroll]] for (uint n = 0; n < wgN; n++)
            sums[j][n] = 0.0;

    // This thread owns the K_PER_ITER-wide chunks at
    // K_PER_ITER * (i * wgSize + tid), i = 0..numIters-1.
    uint numIters = K / (K_PER_ITER * wgSize);
    if (numIters * K_PER_ITER * wgSize + K_PER_ITER * tid < K)
        numIters++;

    // ggml's unroll schedule: 4-deep, then 2-deep, then the tail. With an
    // unaligned K the final iteration must run lastIter == true for the OOB
    // masks, so it is pushed out of the unrolled loops.
    uint unrollCount   = 4;
    uint unrolledIters = numIters & ~(unrollCount - 1);
    if (aligned == 0u && unrolledIters == numIters && unrolledIters > 0)
        unrolledIters -= unrollCount;

    uint i = 0;
    while (i < unrolledIters)
    {
        [[unroll]] for (uint u = 0; u < 4; u++)
        {
            dotKChunk(sums, n0, nCount, tid, i, false);
            i++;
        }
    }

    unrollCount   = 2;
    unrolledIters = numIters & ~(unrollCount - 1);
    if (aligned == 0u && unrolledIters == numIters && unrolledIters > 0)
        unrolledIters -= unrollCount;

    while (i < unrolledIters)
    {
        [[unroll]] for (uint u = 0; u < 2; u++)
        {
            dotKChunk(sums, n0, nCount, tid, i, false);
            i++;
        }
    }

    while (i < numIters)
    {
        dotKChunk(sums, n0, nCount, tid, i, true);
        i++;
    }

    // Reduce: subgroupAdd within each subgroup; multi-subgroup workgroups
    // (wgSize > sgSize — spec-folded, so each pipeline compiles to exactly
    // one mode) fold the per-subgroup partials through tmpsh.
    // The partials go through subgroupAdd four at a time: one call per
    // output failed to link on an Adreno 830 past 4 outputs (M > 2 with
    // fp16 W). Outputs past nCount are zero and reduce harmlessly.
    [[unroll]] for (uint c = 0; c < (M * wgN + 3) / 4; c++)
    {
        vec4 v;
        [[unroll]] for (uint e = 0; e < 4; e++)
        {
            const uint f = 4 * c + e;
            v[e] = (f < M * wgN) ? sums[f / wgN][f % wgN] : 0.0;
        }
        v = subgroupAdd(v);
        [[unroll]] for (uint e = 0; e < 4; e++)
        {
            const uint f = 4 * c + e;
            if (f < M * wgN) sums[f / wgN][f % wgN] = v[e];
        }
    }

    if (wgSize > sgSize)
    {
        if (gl_SubgroupInvocationID == 0)
            [[unroll]] for (uint j = 0; j < M; j++)
                [[unroll]] for (uint n = 0; n < nCount; n++)
                    tmpsh[j][n][gl_SubgroupID] = sums[j][n];
        barrier();
        if (tid == 0)
        {
            [[unroll]] for (uint j = 0; j < M; j++)
            {
                [[unroll]] for (uint n = 0; n < nCount; n++)
                {
                    sums[j][n] = 0.0;
                    [[unroll]] for (uint s = 0; s < gl_NumSubgroups; s++)
                        sums[j][n] += tmpsh[j][n][s];
                }
            }
        }
    }

    // Store: thread 0 adds the bias, applies the epilogue and folds the residual in.
    if (tid != 0) return;
    [[unroll]] for (uint j = 0; j < M; j++)
    {
        [[unroll]] for (uint n = 0; n < nCount; n++)
        {
            const uint idx = j * N + n0 + n;
            const float acc = sums[j][n] + readBias(idx);
            const float r = readR(idx);
            writeO(idx, (residualOrder == 1u) ? scalarScale * applyEpilogue(acc + r)
                                              : scalarScale * applyEpilogue(acc) + r);
        }
    }
}

void main()
{
    // x + numWG.x * z re-linearizes the z-split grid (identity when gz == 1).
    const uint n0 = (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z) * wgN;
    if (n0 >= N)
        return;

    // Full groups pass wgN so nCount stays a compile-time constant there (the
    // sums indexing folds to literals); only the last group can be short and
    // takes a runtime count.
    if (n0 + wgN <= N)
        computeOutputs(n0, wgN);
    else
        computeOutputs(n0, N - n0);
}
