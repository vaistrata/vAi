/*=============================================================================
 General FP16 cooperative-matrix implicit-GEMM convolution.
 A/B operands are FP16. typeAcc selects FP16 (0) or FP32 (1) accumulation.
 Bindings: O=0, I=1, W=2, BIAS=3, SCALE=4, RESIDUAL=5.
 Dispatch: x/y are plan-selected pc.n/pc.co tiles, z=pc.batch images.
 Push constants: PushConstants.
=============================================================================*/
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#include "common/activation.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint wgSize = 128u;
layout(constant_id = 1) const uint wgM = 32u;
layout(constant_id = 2) const uint wgN = 32u;
layout(constant_id = 3) const uint panelK = 32u;
layout(constant_id = 4) const uint sgM = 16u; // M tile dimension computed by each subgroup.
layout(constant_id = 5) const uint sgN = 16u; // N tile dimension computed by each subgroup.
layout(constant_id = 6) const bool shortcut = false;
layout(constant_id = 7) const uint residualOrder = 0u;  // 0: after the epilogue, 1: before it
layout(constant_id = SPEC_ID_TYPE_CI) const uint CI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_CO) const uint CO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_HI) const uint HI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_HO) const uint HO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_WI) const uint WI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_WO) const uint WO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0u;
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0u;
layout(constant_id = SPEC_ID_TYPE_P) const uint typeP = 0u;
layout(constant_id = SPEC_ID_TYPE_ACC) const uint typeAcc = 1u;
layout(constant_id = SPEC_ID_HAS_SCALE) const uint hasScale = 0u;
layout(constant_id = SPEC_ID_HAS_BIAS) const uint hasBias = 1u;

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };
layout(set = 0, binding = 2) restrict readonly buffer W_BUF_F16 { float16_t bufferW_f16[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F32 { float bufferBias_f32[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F16 { float16_t bufferBias_f16[]; };
layout(set = 0, binding = 4) restrict readonly buffer SCALE_BUF_F32 { float bufferScale_f32[]; };
layout(set = 0, binding = 4) restrict readonly buffer SCALE_BUF_F16 { float16_t bufferScale_f16[]; };
layout(set = 0, binding = 5) restrict readonly buffer RES_BUF_F32 { float bufferRes_f32[]; };
layout(set = 0, binding = 5) restrict readonly buffer RES_BUF_F16 { float16_t bufferRes_f16[]; };

layout(push_constant) uniform PushConstants {
    uint hi; uint wi; uint ho; uint wo; uint ci; uint co;
    uint n; uint splitCount; uint kernel; uint stride;
    uint batch;             // images, stacked on the dispatch z axis
} pc;

#include "common/conv_batch.h"

const uint tile = 16u;
const uint subgroupSize = 32u;
const uint subgroupCount = wgSize / subgroupSize;
const uint outputTileElements = tile * tile;
// Keep an FP32 scratch tile ahead of the FP16 accumulator store. This matches
// the layout used by the established CM kernels and keeps NVIDIA's FP16
// coopMatStore base correctly aligned.
shared float Cs32[typeAcc == DTYPE_F16 ? subgroupCount * outputTileElements : outputTileElements];
shared float16_t Cs16[typeAcc == DTYPE_F32 ? subgroupCount * outputTileElements : 1u];
shared float16_t Bs[panelK * wgN];

#define matA coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseA>
#define matB coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseB>
#define acc16 coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseAccumulator>
#define acc32 coopmat<float, gl_ScopeSubgroup, tile, tile, gl_MatrixUseAccumulator>

// The workgroup's image within I, and within O and the residual.
uint imageInputBase = 0u;
uint imageOutputBase = 0u;

float readI(uint index) { index += imageInputBase; return typeI == DTYPE_F32 ? bufferI_f32[index] : float(bufferI_f16[index]); }
float readBias(uint c)
{
    if (hasBias == 0u) return 0.0;
    return typeP == DTYPE_F32 ? bufferBias_f32[c] : float(bufferBias_f16[c]);
}
float readScale(uint c) { return typeP == DTYPE_F32 ? bufferScale_f32[c] : float(bufferScale_f16[c]); }
float readResidual(uint index) { index += imageOutputBase; return typeI == DTYPE_F32 ? bufferRes_f32[index] : float(bufferRes_f16[index]); }
void writeO(uint index, float value) { index += imageOutputBase; if (typeO == DTYPE_F32) bufferO_f32[index] = value; else bufferO_f16[index] = float16_t(value); }

float readConvInput(uint k, uint n, uint Hi, uint Wi, uint Wo, uint Ci)
{
    const uint taps = pc.kernel * pc.kernel;
    const uint c = k / taps;
    const uint tapIndex = k - c * taps;
    const uint kh = tapIndex / pc.kernel;
    const uint kw = tapIndex - kh * pc.kernel;
    const uint hOut = n / Wo;
    const uint wOut = n - hOut * Wo;
    const int pad = int(pc.kernel >> 1u);
    const int hIn = int(hOut * pc.stride) + (int(kh) - pad);
    const int wIn = int(wOut * pc.stride) + (int(kw) - pad);
    if (c >= Ci || hIn < 0 || wIn < 0 || hIn >= int(Hi) || wIn >= int(Wi)) return 0.0;
    return readI((c * Hi + uint(hIn)) * Wi + uint(wIn));
}

float finishOutput(uint channel, uint index, float value)
{
    value = hasScale == 0u ? value + readBias(channel) : fma(value, readScale(channel), readBias(channel));
    if (shortcut && residualOrder == 1u) value += readResidual(index);
    value = applyEpilogue(value);
    if (shortcut && residualOrder == 0u) value += readResidual(index);
    return value;
}

void fillB(uint panelBase, uint rawK, uint N, uint Hi, uint Wi, uint Wo, uint Ci, uint nBase)
{
    for (uint index = gl_LocalInvocationID.x; index < panelK * wgN; index += wgSize)
    {
        const uint kLocal = index / wgN;
        const uint nLocal = index - kLocal * wgN;
        const uint k = panelBase + kLocal;
        const uint n = nBase + nLocal;
        Bs[index] = float16_t(k < rawK && n < N ? readConvInput(k, n, Hi, Wi, Wo, Ci) : 0.0);
    }
}

void main()
{
    const uint Hi = HI_SPEC != 0u ? HI_SPEC : pc.hi;
    const uint Wi = WI_SPEC != 0u ? WI_SPEC : pc.wi;
    const uint Ho = HO_SPEC != 0u ? HO_SPEC : pc.ho;
    const uint Wo = WO_SPEC != 0u ? WO_SPEC : pc.wo;
    const uint Ci = CI_SPEC != 0u ? CI_SPEC : pc.ci;
    const uint Co = CO_SPEC != 0u ? CO_SPEC : pc.co;
    const uint N = Ho * Wo;
    const uint image = convImage(pc.batch);
    imageInputBase = image * Ci * Hi * Wi;
    imageOutputBase = image * Co * N;
    const uint rawK = Ci * pc.kernel * pc.kernel;
    const uint paddedK = ((rawK + 15u) / 16u) * 16u;
    const uint kTiles = paddedK / 16u;
    const uint sgCountN = wgN / sgN;
    const uint subgroup = gl_SubgroupID;
    const uint subgroupM = subgroup / sgCountN;
    const uint subgroupN = subgroup - subgroupM * sgCountN;
    const uint m0 = gl_WorkGroupID.y * wgM + subgroupM * sgM;
    const uint n0 = gl_WorkGroupID.x * wgN + subgroupN * sgN;
    const uint mTile = m0 / 16u;

    if (typeAcc == DTYPE_F32)
    {
        acc16 acc = acc16(float16_t(0.0));
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, N, Hi, Wi, Wo, Ci, gl_WorkGroupID.x * wgN);
            barrier();
            for (uint kLocal = 0u; kLocal < panelK; kLocal += 16u)
            {
                matA a = matA(float16_t(0.0));
                matB b;
                if (panelBase + kLocal < paddedK)
                    coopMatLoad(a, bufferW_f16, (mTile * kTiles + (panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b, Bs, kLocal * wgN + subgroupN * sgN, wgN, gl_CooperativeMatrixLayoutRowMajor);
                acc = coopMatMulAdd(a, b, acc);
            }
            barrier();
        }
        const uint sharedBase = subgroup * outputTileElements;
        coopMatStore(acc, Cs16, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < outputTileElements; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u; const uint n = n0 + i % 16u;
            if (m < Co && n < N) { const uint outputIndex = m * N + n; writeO(outputIndex, finishOutput(m, outputIndex, float(Cs16[sharedBase + i]))); }
        }
    }
    else
    {
        acc32 acc = acc32(0.0);
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, N, Hi, Wi, Wo, Ci, gl_WorkGroupID.x * wgN);
            barrier();
            for (uint kLocal = 0u; kLocal < panelK; kLocal += 16u)
            {
                matA a = matA(float16_t(0.0));
                matB b;
                if (panelBase + kLocal < paddedK)
                    coopMatLoad(a, bufferW_f16, (mTile * kTiles + (panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b, Bs, kLocal * wgN + subgroupN * sgN, wgN, gl_CooperativeMatrixLayoutRowMajor);
                acc = coopMatMulAdd(a, b, acc);
            }
            barrier();
        }
        const uint sharedBase = subgroup * outputTileElements;
        coopMatStore(acc, Cs32, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < outputTileElements; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u; const uint n = n0 + i % 16u;
            if (m < Co && n < N) { const uint outputIndex = m * N + n; writeO(outputIndex, finishOutput(m, outputIndex, Cs32[sharedBase + i])); }
        }
    }
}
