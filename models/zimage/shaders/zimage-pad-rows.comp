// =============================================================================
// zimage-pad-rows.comp: pad a token sequence to a row multiple with one
//     learned pad token
//
//     O[i, d] = (i < N) ? I[i, d] : P[d]          i ∈ [0, Npad)
//
// - O (typeO), I (typeI), P (typeW) are fp32 or fp16 via same-binding buffer
//   aliases.
// - One workgroup per output row, its threads striding the feature axis.
// - Dispatch (host): .dispatch(Npad).
// =============================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0;   // pad token

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };   // [Npad, D]
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32  { float bufferI_f32[]; };   // [N, D]
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16  { float16_t bufferI_f16[]; };
layout(set = 0, binding = 2) restrict readonly buffer P_BUF_F32  { float bufferP_f32[]; };   // [D]
layout(set = 0, binding = 2) restrict readonly buffer P_BUF_F16  { float16_t bufferP_f16[]; };

layout(push_constant) uniform PushConstants {
    uint N;      // real rows
    uint Npad;   // output rows
    uint D;
};

float readI(uint i) { return (typeI == 0u) ? bufferI_f32[i] : float(bufferI_f16[i]); }
float readP(uint j) { return (typeW == 0u) ? bufferP_f32[j] : float(bufferP_f16[j]); }
void writeO(uint i, float v) { if (typeO == 0u) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    uint row = gl_WorkGroupID.x;
    if (row >= Npad) return;

    for (uint d = gl_LocalInvocationID.x; d < D; d += 256u)
        writeO(row * D + d, (row < N) ? readI(row * D + d) : readP(d));
}
