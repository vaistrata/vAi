/*=============================================================================
 sinusoidal-pos-emb.comp: a timestep's sinusoidal embedding (lerobot's
 DiffusionSinusoidalPosEmb)
     f_i      = exp(-i · log(10000) / (halfDim - 1)),   i < halfDim = dim / 2
     O[r, i]        = sin(I[r] · f_i)
     O[r, halfDim + i] = cos(I[r] · f_i)

 The argument is formed in fp32, as torch forms it, then reduced to [-π, π]
 (Cody–Waite, 2π split in two) before sin / cos: their precision is only
 specified on that range, and timesteps run to the scheduler's last (e.g. 99).
 - O (typeO), I (typeI) are fp32 or fp16 via same-binding buffer aliases.
 One thread per output element. Dispatch (host): dispatch2(rows * dim).
 Push constants: rows, dim.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 256) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;     // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;     // I (timestep) dtype

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };

layout(push_constant) uniform PushConstants {
    uint rows;   // timesteps
    uint dim;    // embedding width, even
};

float readI(uint i) { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// x - 2π · round(x / 2π), 2π = TWO_PI_HI + TWO_PI_LO so the product stays exact.
const float TWO_PI_HI = 6.28125;
const float TWO_PI_LO = 1.9353071795864769e-3;
float reduceAngle(float x)
{
    const float n = round(x * 0.15915494309189535);
    return (x - n * TWO_PI_HI) - n * TWO_PI_LO;
}

void main()
{
    const uint e = gl_GlobalInvocationID.x;
    if (e >= rows * dim) return;

    const uint r = e / dim;
    const uint col = e - r * dim;
    const uint halfDim = dim / 2u;
    const uint i = col < halfDim ? col : col - halfDim;

    const float scale = log(10000.0) / float(halfDim - 1u);
    const float freq = exp(float(i) * -scale);
    const float arg = reduceAngle(readI(r) * freq);
    writeO(e, col < halfDim ? sin(arg) : cos(arg));
}
