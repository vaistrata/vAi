/*=============================================================================
 rope.comp:
     RoPE (rotary position embedding), half-split rotation.

 - O (typeO) / I (typeI) [H, Tq, Dh] are fp32 or fp16, accessed through
   same-binding buffer aliases. The rotation itself is always fp32.
 - freqs [Dh/2] is always fp32: it is tiny and the angles are precision
   critical, so it does not follow the parameter dtype.
 - freqs[d] already carries whatever frequency scaling the model wants; the
   host precomputes it once (see RopeNode).
 - Half-split rotation (same as HuggingFace LLaMA):
     x1 = x[..., :Dh/2]   x2 = x[..., Dh/2:]
     result = x * cos + rotate_half(x) * sin
 - posType picks how pair d of token tq gets its position. posParam is one
   uint the host writes, read at dispatch time; what it means depends on posType:
     POS_SEQUENTIAL: posParam + tq, posParam the first input token's position
     POS_GRID2D:     tokens are a raster grid posParam wide; the first half of
                     the pairs turns by the row tq / posParam, the second by the
                     column tq % posParam
     POS_MROPE:      positions[tq * 3 + axisOf(d)], (t, h, w) rows the model
                     writes
   Only POS_MROPE reads positions, and it alone leaves posParam unread; the
   binding a type does not read stays null.
 - MRoPE interleaves the axes: pair d takes axis d % 3 (t, h, w) while h has
   pairs left (d < 3 * sectionH) and w likewise (d < 3 * sectionW); every other
   pair takes t.

 Dispatch (host): dispatch2(Dh / 2, Tq, H) -- one thread per rotated pair.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/spec_constants.h"

layout(local_size_x = 32) in;

layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0;  // I (input) dtype
layout(constant_id = 0) const uint posType = 0u;           // POS_* below
layout(constant_id = 1) const uint sectionH = 0u;          // MRoPE pairs on h (POS_MROPE only)
layout(constant_id = 2) const uint sectionW = 0u;          // ... on w

const uint POS_SEQUENTIAL = 0u;
const uint POS_GRID2D = 1u;
const uint POS_MROPE = 2u;

layout(set = 0, binding = 0) buffer O_BUF_F32 { float bO_f32[]; };
layout(set = 0, binding = 0) buffer O_BUF_F16 { float16_t bO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) buffer I_BUF_F32 { float bI_f32[]; };
layout(set = 0, binding = 1) buffer I_BUF_F16 { float16_t bI_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 2) readonly buffer FREQS_BUF { float bFreqs[]; };
layout(set = 0, binding = 3) uniform PosParam { uint posParam; };
layout(set = 0, binding = 4) readonly buffer POSITIONS_BUF { uint bPositions[]; };

layout(push_constant) uniform PushConstants {
    uint H;         // number of heads
    uint Tq;        // query tokens this forward
    uint Dh;        // head dimension (even)
};

float readI(uint i)          { return (typeI == DTYPE_F32) ? bI_f32[i] : float(bI_f16[i]); }
void writeO(uint i, float v) { if (typeO == DTYPE_F32) bO_f32[i] = v; else bO_f16[i] = float16_t(v); }

// The MRoPE axis pair d turns by: 0 t, 1 h, 2 w.
uint axisOf(uint d)
{
    return (d % 3u == 1u && d < 3u * sectionH) || (d % 3u == 2u && d < 3u * sectionW) ? d % 3u : 0u;
}

void main()
{
    uint d = gl_GlobalInvocationID.x;    // pair index (coalesced)
    uint tq = gl_GlobalInvocationID.y;    // token index
    uint h = gl_GlobalInvocationID.z;    // head index

    uint halfDh = Dh / 2;
    if (d >= halfDh || tq >= Tq || h >= H) return;

    uint pos = 
        (posType == POS_SEQUENTIAL) ? posParam + tq : 
        (posType == POS_GRID2D) ? (d < halfDh / 2) ? tq / posParam : tq % posParam : 
          bPositions[tq * 3u + axisOf(d)];

    float angle = float(pos) * bFreqs[d];
    float cos_ = cos(angle);
    float sin_ = sin(angle);

    uint idx1 = (h * Tq + tq) * Dh + d;
    uint idx2 = idx1 + halfDh;
    float x1 = readI(idx1);
    float x2 = readI(idx2);

    writeO(idx1, cos_ * x1 - sin_ * x2);
    writeO(idx2, sin_ * x1 + cos_ * x2);
}
