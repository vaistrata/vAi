/*=============================================================================
 attention-fa-cm.comp: flash-attention cooperative-matrix path
     (GEMM structure ported from the ggml/llama.cpp Vulkan flash_attn_cm1.comp)

     The scalar FA kernel's frame (token-major O [B, Tq, Hq, Dh], one
     global-coordinate KV sweep, fused append, counter causality) with the Q.K
     and P.V products as 16x16x16 subgroup coopMatMulAdd. Prefill and
     GQA-packed small-batch decode, with split-K.

 Per tile (wgRows = 16, wgKv = 64, 4 subgroups):
   GEMM1   subgroup sg owns KV columns [sg*16, +16): S^T = K * Q^T. S and P
           live transposed in shared ([Bc][Br/4]), so the softmax moves vec4s.
   softmax subgroup sg owns Q rows [sg*4, +4): row max per tile and online
           rescale, in log2 units; P staged to shared as f16.
   GEMM2   subgroup sg owns head-dim chunks {sg, sg+4, ...}: P * V in f32,
           drained through s_s into the acc registers with the row rescale
           (pvDrainParts: unstaged, one head-dim part at a time).
           persistentOAcc keeps O in the coopmat accumulators across tiles
           instead, rescaled only when a row max jumps.

 K/V staging (shmemStaging): staged pipelines copy full tiles in KV_PARTS
 head-dim parts of 128 dims or stagedPartDims (16-byte loads with kvWideLoads; prefetchV issues the V loads
 before GEMM1) and select / zero-fill only the boundary tile. Unstaged pipelines
 coopMatLoad f16 tiles straight from global (f32 sources and padded Dh stage;
 directLoadPaddedDh loads padded input tiles direct) and stage the boundary tile, in
 SMALL_KV where it fits. Excluded positions
 hold -inf in S, so exp gives exact 0.

 Split-K: spans of the keys the tile reaches, derived from kvCacheCount (the
 cache grows under one recording); with skipEmptySplits a split with no keys
 leaves early. appendBeforeSweep keeps the new token on the last split, which
 appends it and reads it back; the cache's last partial tile goes with it, so
 the other splits sweep whole tiles alone and none reads a row being appended.

 A tile that runs past the end of its one source (the tail) is staged like a
 whole one: the rows past the end load the last valid row again, and the
 exclusion compare, which every tail takes, leaves them -inf in S and 0 in P.

 The mask's span bounds a query from below (keyStart, a sliding window); the
 bound joins the exclusion compare and lifts the sweep's start, and a ring
 cache (spec kvCacheRing) keeps the last Tmax positions at row p % Tmax (see
 the scalar kernel).

 The K / V inputs carry Tkv rows (0 = the cache alone), aligned with the Tq
 queries at their ends; the rows past the grid's own are appended by every
 split (splitsAppendExtraKv). A tile that every row of a subgroup sees whole
 skips the per-row exclusion.

 Requirements (host-gated, coopmatFlashAttentionTile): 16x16x16 f16 subgroup
 coopmat shapes with both f32 and f16 accumulators; shared memory per
 tileFitsSharedMemory; more than one row up to Dh 256; packed mode needs gqaRatio <= wgRows;
 wgSize == 4 * sgSize (forced).

 Dispatch (host): (ceil(Tq / wgRows) * kCount, Hq, B);
                  GQA-packed: (Tq * kCount, Hkv, B)
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : require
#include "common/spec_constants.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;   // = wgSize (same SpecId)

layout(constant_id = 0) const uint wgSize       = 128;  // threads per workgroup (= 4 * sgSize)
layout(constant_id = 1) const uint wgRows       = 16;   // Q rows per workgroup tile (= MAT)
layout(constant_id = 2) const uint wgKv         = 64;   // KV columns per tile (= 4 * MAT)
layout(constant_id = 3) const uint Dh           = 64;   // head dim
layout(constant_id = 6) const uint sgSize       = 32;   // device subgroup size (forced on the pipeline)
layout(constant_id = 7) const uint shmemStaging = 0;    // stage K/V tiles through shared f16 (the vendor's choice; = upstream SHMEM_STAGING)
// appendBeforeSweep: the sweep reads the CACHE as its single source (the last
// split appends first, memoryBarrierBuffer for visibility) — tile classes
// collapse to full-vs-tail, folding the boundary/full-input code out.
layout(constant_id = 11) const uint appendBeforeSweep  = 0;
layout(constant_id = 12) const uint kvCacheRing = 0;        // 1: the cache keeps the last Tmax positions, p at row p % Tmax
layout(constant_id = 13) const uint typeI      = 0;         // Q input dtype
layout(constant_id = 14) const uint typeCache  = 0;         // K / V cache dtype
layout(constant_id = 15) const uint kvCaching  = 1;         // 0: skip the append; the cache bindings are null
layout(constant_id = 16) const uint typeKV     = 0;         // K / V input dtype
layout(constant_id = 17) const uint skipEmptySplits = 0;    // a split with no keys marks its partial empty and returns
layout(constant_id = 18) const uint persistentOAcc = 0;     // staged, f32 O: O stays in the coopmat accumulators across key tiles
layout(constant_id = 19) const uint kvWideLoads = 0;        // staged: one-source f16 K/V tiles go to shared 16 bytes per load (a uvec4), not 8
layout(constant_id = 21) const uint prefetchV = 0;          // kvWideLoads: a full f16 tile's V part 0 loads before GEMM1
layout(constant_id = 22) const uint splitsAppendExtraKv = 0;   // every split's workgroups append the K / V rows past the grid's own (Tkv > Tq)
layout(constant_id = 24) const uint pvDrainParts = 0;       // unstaged: P.V drains through s_s in this many head-dim parts (0 / 1: whole)
layout(constant_id = 25) const uint directLoadPaddedDh = 0; // unstaged, Dh % 16 != 0: full f16 input tiles load K / V direct; the pad past Dh reads the next row (x Q's zero pad)
layout(constant_id = 28) const uint smallKvVChunks = 0;     // unstaged: V head-dim chunks the small K/V buffer (SMALL_KV) holds per GEMM2 pass (0: one per subgroup)
layout(constant_id = 29) const uint stagedPartDims = 0;     // staged: head dims per K / V part (0: 128)
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;  // O (output) dtype

// All indices below are in vec4 units (Dh % 4 == 0 is host-guaranteed).
// Memory qualifiers: same split as the scalar kernel (readonly sweep aliases,
// writeonly append aliases) — see the note there.
layout(set = 0, binding = 0) writeonly buffer O_BUF_F32 { vec4 bufferO_f32[]; };   // attention O [B, Tq, Hq, Dh]
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16 { f16vec4 bufferO_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 1) readonly buffer Q_BUF_F32 { vec4 bufferQ_f32[]; };   // query Q [B, Hq, Tq, Dh]
layout(set = 0, binding = 1) readonly buffer Q_BUF_F16 { f16vec4 bufferQ_f16[]; };
layout(set = 0, binding = 2) readonly buffer K_BUF_F32 { vec4 bufferK_f32[]; };   // key   K [B, Hkv, Tkv, Dh] (new tokens)
layout(set = 0, binding = 2) readonly buffer K_BUF_F16 { f16vec4 bufferK_f16[]; };
layout(set = 0, binding = 3) readonly buffer V_BUF_F32 { vec4 bufferV_f32[]; };   // value V [B, Hkv, Tkv, Dh] (new tokens)
layout(set = 0, binding = 3) readonly buffer V_BUF_F16 { f16vec4 bufferV_f16[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 4) readonly buffer KCACHE_BUF_F32 { vec4 bufferKCache_f32[]; };   // K cache [B, Hkv, Tmax, Dh]
layout(set = 0, binding = 4) readonly buffer KCACHE_BUF_F16 { f16vec4 bufferKCache_f16[]; };
layout(set = 0, binding = 4) writeonly buffer KCACHE_W_F32  { vec4 bufferKCacheW_f32[]; };
layout(set = 0, binding = 4) writeonly buffer KCACHE_W_F16  { f16vec4 bufferKCacheW_f16[]; };
layout(set = 0, binding = 5) readonly buffer VCACHE_BUF_F32 { vec4 bufferVCache_f32[]; };   // V cache [B, Hkv, Tmax, Dh]
layout(set = 0, binding = 5) readonly buffer VCACHE_BUF_F16 { f16vec4 bufferVCache_f16[]; };
layout(set = 0, binding = 5) writeonly buffer VCACHE_W_F32  { vec4 bufferVCacheW_f32[]; };
layout(set = 0, binding = 5) writeonly buffer VCACHE_W_F16  { f16vec4 bufferVCacheW_f16[]; };
// 16-byte views of the f16 K/V sources (kvWideLoads).
layout(set = 0, binding = 2) readonly buffer K_BUF_U4      { uvec4 bufferK_u4[]; };
layout(set = 0, binding = 3) readonly buffer V_BUF_U4      { uvec4 bufferV_u4[]; };
layout(set = 0, binding = 4) readonly buffer KCACHE_BUF_U4 { uvec4 bufferKCache_u4[]; };
layout(set = 0, binding = 5) readonly buffer VCACHE_BUF_U4 { uvec4 bufferVCache_u4[]; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 6) uniform UB { uint kvCacheCount; };
//////////////////////////////////////////////////////////////////////////////
layout(set = 0, binding = 7) buffer PO_BUF  { vec4 partialO[];   };   // [B*Tq*Hq, kCount, Dh/4] unnormalized acc (fp32)
layout(set = 0, binding = 8) buffer PML_BUF { float partialML[]; };   // [B*Tq*Hq, kCount, (m, l)] (fp32)

layout(push_constant) uniform PushConstants {
    uint DhPush;   // unused (Dh is a spec constant); keeps the FA kernel's layout
    uint Hq;
    uint groupSize; // Hq / Hkv: query heads sharing one KV head
    uint Tq;
    uint Tkv;      // K / V input rows
    uint Tmax;
    uint gqaRatio; // > 1: GQA-packed decode (tile rows = the groupSize heads of one KV group)
    uint kCount;   // KV splits (1 = no split; > 1 = two-pass with the reduce kernel)
    float scale;
};

#define CAUSAL_MASK_BINDING 9
#include "common/causal_mask.h"

// newTokenEnd among the Tkv new keys, queries and keys aligned at their ends:
// query t sits at key t + Tkv - Tq.
uint keyEnd(uint t)
{
    return uint(max(int(newTokenEnd(t) + Tkv) - int(Tq), 0));
}

// Query t's own key position, in the same alignment keyEnd uses.
uint keyPos(uint t)
{
    return kvCacheCount + uint(max(int(t + Tkv) - int(Tq), 0));
}

// The cache row that holds position p.
uint cacheRow(uint p)
{
    return (kvCacheRing != 0u) ? p % Tmax : p;
}

// O and the split-K partials are both indexed by this row, so the reduce pass
// writes straight through. With one sequence b is 0 and it is the plain
// token-major row.
uint outRow(uint tq, uint hq) { return (gl_WorkGroupID.z * Tq + tq) * Hq + hq; }

// Split origin: the first key the tile's oldest row t may read (the mask's span), aligned down to wgKv; 0 without a span.
uint spanOrigin(uint t)
{
    return keyStart(keyPos(t)) & ~(wgKv - 1u);
}

vec4 readQ4(uint i) { return (typeI == DTYPE_F32) ? bufferQ_f32[i] : vec4(bufferQ_f16[i]); }
// Direct-to-f16 staging readers: f16 sources copy without a f32 roundtrip.
f16vec4 readK4h(uint i) { return (typeKV == DTYPE_F32) ? f16vec4(bufferK_f32[i]) : bufferK_f16[i]; }
f16vec4 readV4h(uint i) { return (typeKV == DTYPE_F32) ? f16vec4(bufferV_f32[i]) : bufferV_f16[i]; }
f16vec4 readKCache4h(uint i) { return (typeCache == DTYPE_F32) ? f16vec4(bufferKCache_f32[i]) : bufferKCache_f16[i]; }
f16vec4 readVCache4h(uint i) { return (typeCache == DTYPE_F32) ? f16vec4(bufferVCache_f32[i]) : bufferVCache_f16[i]; }
vec4 readK4(uint i) { return (typeKV == DTYPE_F32) ? bufferK_f32[i] : vec4(bufferK_f16[i]); }
vec4 readV4(uint i) { return (typeKV == DTYPE_F32) ? bufferV_f32[i] : vec4(bufferV_f16[i]); }
void writeO4(uint i, vec4 v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = f16vec4(v); }
void writeKCache4(uint i, vec4 v) { if (typeCache == DTYPE_F32) bufferKCacheW_f32[i] = v; else bufferKCacheW_f16[i] = f16vec4(v); }
void writeVCache4(uint i, vec4 v) { if (typeCache == DTYPE_F32) bufferVCacheW_f32[i] = v; else bufferVCacheW_f16[i] = f16vec4(v); }

const uint MAT           = 16u;                               // cooperative-matrix dimension (16x16x16)
const uint NUM_SG        = wgSize / sgSize;                   // = rowGroups = 4
const uint ROWS_PER_SG   = wgRows / NUM_SG;                   // Q rows owned per subgroup in softmax (4)
const uint COLS_PER_LANE = wgKv / sgSize;                     // S columns per lane in softmax (2 or 1)
const uint DH_PAD        = (Dh + MAT - 1u) & ~(MAT - 1u);     // head dim padded to 16
const uint DH_CHUNKS     = DH_PAD / MAT;
const uint KV_CHUNKS     = wgKv / MAT;                        // = 4
const uint DH4           = Dh / 4u;                           // head dim in vec4s
const uint DH4_PAD       = DH_PAD / 4u;
const uint PV4_PER_LANE  = (DH4_PAD + sgSize - 1u) / sgSize;  // acc vec4 stripe per lane

// Shared staging, vec4 elements; +2 vec4 padding keeps coopMatLoad off bank conflicts.
const uint Q_STRIDE  = DH4_PAD + 2u;   // f16vec4
// Staged tiles take the head dim in parts of 128 dims, or stagedPartDims (the host budget mirrors this);
// CHUNKS_PART must be a multiple of NUM_SG.
const uint KV_PART_DH4 = (stagedPartDims != 0u) ? stagedPartDims / 4u : 32u;
const uint KV_PARTS    = (shmemStaging != 0u) ? ((DH4_PAD > KV_PART_DH4) ? DH4_PAD / KV_PART_DH4 : 1u) : 1u;
const uint DH4_PART    = DH4_PAD / KV_PARTS;
const uint CHUNKS_PART = DH_CHUNKS / KV_PARTS;
const uint KV_STRIDE   = DH4_PART + 2u;  // f16vec4
// nested selects: glslc -O rejects && between spec-constant terms
const bool WIDE_KV      = (kvWideLoads != 0u) ? ((DH4_PAD == DH4) ? ((DH4 % 2u == 0u) ? (DH4_PART % 2u == 0u) : false) : false) : false;
// S and P are held TRANSPOSED ([Bc][Br/4]) so one vec4 covers four Q rows.
// +2 pad only on the staged append-before-sweep decode: it eats bank
// conflicts there, while an unstaged tile gains more from the shared memory
// the pad would take. Prefill was always unpadded.
const uint SP_PAD   = (appendBeforeSweep != 0u && shmemStaging != 0u) ? 2u : 0u;
const uint S_STRIDE = wgRows / 4u + SP_PAD;   // vec4 (f32), row-packed
const uint P_STRIDE = wgRows / 4u + SP_PAD;   // f16vec4, row-packed
// GEMM2's f32 P.V drains through s_s (S^T is dead once P^T is written), one
// head-dim part at a time: no tile's partial sum is rounded to f16 on the way
// to the f32 accumulator registers (precision rule: >= llama.cpp cm1 / cm2).
// Unstaged pipelines can drain in parts too (pvDrainParts), so s_s holds one part; CHUNKS_DRAIN must be a
// multiple of NUM_SG (the host's part counts keep it so). Staged pipelines drain per K / V part.
const uint DRAIN_PARTS  = (shmemStaging != 0u) ? KV_PARTS : ((pvDrainParts > 1u) ? pvDrainParts : 1u);
const uint DH4_DRAIN    = DH4_PAD / DRAIN_PARTS;
const uint CHUNKS_DRAIN = DH_CHUNKS / DRAIN_PARTS;
const uint PV_STRIDE = DH4_DRAIN + 2u;   // vec4 (f32)
const uint SS_DRAIN  = (wgKv * S_STRIDE > wgRows * PV_STRIDE) ? wgKv * S_STRIDE : wgRows * PV_STRIDE;
const bool PERSISTENT_O = (persistentOAcc != 0u) && (shmemStaging != 0u);
const uint OC_PER_SG = (DH_CHUNKS + NUM_SG - 1u) / NUM_SG;    // PERSISTENT_O: O chunks a subgroup owns
const uint CORR_BASE = SS_DRAIN;                              // PERSISTENT_O: per-row corr, one vec4 per four rows
const uint SS_SIZE   = PERSISTENT_O ? SS_DRAIN + wgRows / 4u : SS_DRAIN;
const float RESCALE_LOG2 = 8.0;   // PERSISTENT_O: P stays <= 2^(8 - 3) = 32 in f16

// Small unstaged staging (= ggml SHMEM_STAGING=0 kvsh): when full tiles
// direct-load, s_kv only serves the boundary/tail tile and shrinks to the
// union of one 16-wide K chunk and one GEMM2 V pass. appendBeforeSweep stays
// excluded: the chunked boundary path in that binary re-creates the
// class-presence penalty it removes. A V pass holds VP_CHUNKS head-dim chunks:
// one per subgroup, or smallKvVChunks (>= 2: the K chunk has to fit), which
// leaves the other subgroups idle in the boundary tile's GEMM2.
const bool SMALL_KV  = (shmemStaging == 0u) && (DH4_PAD == DH4) && (appendBeforeSweep == 0u);
const uint KB_STRIDE = MAT / 4u + 2u;        // f16vec4 (= upstream MatBr/4 + 2)
const uint VP_CHUNKS = (smallKvVChunks != 0u) ? smallKvVChunks : NUM_SG;
const uint VS_STRIDE = VP_CHUNKS * MAT / 4u; // f16vec4 (= upstream v_cols, no pad)

#define NEG_INF uintBitsToFloat(0xFF800000u)
// The softmax runs in log2 units (log2(e) folds into the S scale, one exp2 per exp); the split
// partials leave in natural units (m * ln 2).
const float LOG2E = 1.4426950408889634;
const float LN2   = 0.6931471805599453;
const float QK_MAX_OFFSET = 3.0;   // log2(8) (= ggml FATTN_KQ_MAX_OFFSET)

shared f16vec4 s_q[wgRows * Q_STRIDE];      // Q tile, unscaled (scale applied to S)
shared f16vec4 s_kv[SMALL_KV ? wgKv * VS_STRIDE : wgKv * KV_STRIDE];   // one head-dim part of the K, then V tile (SMALL_KV: boundary-only chunks), zero-filled
// S is fp32 fixed (= llama.cpp production, PREC_F32 always)
shared vec4 s_s[SS_SIZE];                   // S^T, then the P.V drain (f32)
shared f16vec4 s_p[wgKv * P_STRIDE];        // P^T = exp2(S * log2(e) - m) exchange

// Direct global coopMatLoad for unstaged full f16 tiles; f32-source tiles
// stage instead (an f32 A/B coopmat is a shape no device reports).
coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> loadKDirect(bool fromCache, uint off)
{
    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> A;
    if (fromCache) coopMatLoad(A, bufferKCache_f16, off, DH4, gl_CooperativeMatrixLayoutRowMajor);
    else           coopMatLoad(A, bufferK_f16,      off, DH4, gl_CooperativeMatrixLayoutRowMajor);
    return A;
}

coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> loadVDirect(bool fromCache, uint off)
{
    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> B;
    if (fromCache) coopMatLoad(B, bufferVCache_f16, off, DH4, gl_CooperativeMatrixLayoutRowMajor);
    else           coopMatLoad(B, bufferV_f16,      off, DH4, gl_CooperativeMatrixLayoutRowMajor);
    return B;
}

// Boundary-tile staging for the small buffer (SMALL_KV only): one 16-wide
// head-dim chunk of K for the whole tile, zero-fill + per-row source select.
void stageKChunkSmall(uint jBase, uint dc, uint inputEnd,
                      uint kvCacheBase, uint kvInputBase, uint tid)
{
    [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * (MAT / 4u); idx0 += wgSize)
    {
        uint idx = idx0 + tid;
        if (idx0 + wgSize <= wgKv * (MAT / 4u) || idx < wgKv * (MAT / 4u))
        {
            uint c = idx / (MAT / 4u), dv = idx % (MAT / 4u);
            uint j = jBase + c;
            uint d = dc * (MAT / 4u) + dv;   // < DH4 under SMALL_KV (DH4_PAD == DH4)
            f16vec4 v = f16vec4(0.0);
            if (DH4_PAD == DH4 || d < DH4)
            {
                // appendBeforeSweep: single-source guarded tail (no cache/input select).
                if (appendBeforeSweep != 0u)
                {
                    if (j < inputEnd) v = readKCache4h(kvCacheBase + j * DH4 + d);
                }
                else if (j < kvCacheCount) v = readKCache4h(kvCacheBase + j * DH4 + d);
                else if (j < inputEnd)         v = readK4h(kvInputBase + (j - kvCacheCount) * DH4 + d);
            }
            s_kv[c * KB_STRIDE + dv] = v;
        }
    }
}

// Same for V: the VP_CHUNKS head-dim chunks of one GEMM2 pass.
void stageVPassSmall(uint jBase, uint pass, uint inputEnd,
                     uint kvCacheBase, uint kvInputBase, uint tid)
{
    [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * VS_STRIDE; idx0 += wgSize)
    {
        uint idx = idx0 + tid;
        if (idx0 + wgSize <= wgKv * VS_STRIDE || idx < wgKv * VS_STRIDE)
        {
            uint c = idx / VS_STRIDE, dv = idx % VS_STRIDE;
            uint j = jBase + c;
            uint d = pass * VS_STRIDE + dv;
            f16vec4 v = f16vec4(0.0);
            if (d < DH4)   // pass tail past Dh stays zero (DH_CHUNKS % NUM_SG != 0 shapes)
            {
                // appendBeforeSweep: single-source guarded tail (see the K chunk).
                if (appendBeforeSweep != 0u)
                {
                    if (j < inputEnd) v = readVCache4h(kvCacheBase + j * DH4 + d);
                }
                else if (j < kvCacheCount) v = readVCache4h(kvCacheBase + j * DH4 + d);
                else if (j < inputEnd)         v = readV4h(kvInputBase + (j - kvCacheCount) * DH4 + d);
            }
            s_kv[c * VS_STRIDE + dv] = v;
        }
    }
}

// Tile-local row -> (query head, query token) — same mapping as the scalar
// kernel. Non-packed: rows are Q tokens of head wgY. Packed: rows are the
// gqaRatio query heads of KV group wgY, all at token qTile.
#define ROW_HEAD(row)  (packed ? wgY * gqaRatio + (row) : wgY)
#define ROW_TOK(row)   (packed ? qTile : qTile * wgRows + (row))
#define ROW_VALID(row) (packed ? (row) < gqaRatio : qTile * wgRows + (row) < Tq)

// One head-dim part of P.V from s_s into acc, rescaled by corr.
#define PULL_PV(part)                                                                              \
    [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r)                                             \
        [[unroll]] for (uint k = 0u; k < PV4_PER_LANE; ++k)                                        \
        {                                                                                          \
            uint d = k * sgSize + lane;                                                            \
            if (d < DH4 && d >= (part) * DH4_DRAIN && d < (part) * DH4_DRAIN + DH4_DRAIN)          \
            {                                                                                      \
                acc32[r * PV4_PER_LANE + k] = acc32[r * PV4_PER_LANE + k] * corr[r]                \
                    + s_s[(rowBase + r) * PV_STRIDE + d - (part) * DH4_DRAIN];                     \
            }                                                                                      \
        }

f16vec4 halfLo(uvec4 u) { return f16vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y)); }
f16vec4 halfHi(uvec4 u) { return f16vec4(unpackFloat2x16(u.z), unpackFloat2x16(u.w)); }

// WIDE_KV: one full f16 tile part in 16-byte loads (uvec4 index = f16vec4 index / 2).
// which: 0 K cache, 1 K input, 2 V cache, 3 V input.
const uint WIDE_PER_THREAD = (wgKv * DH4_PART / 2u + wgSize - 1u) / wgSize;   // uvec4 per thread per tile part
const bool PREFETCH_V = (prefetchV != 0u) ? WIDE_KV : false;

// prefetchV: the load half of stageWide (part 0) into registers, and the store half.
void loadWide(uint which, uint base, uint tid, uint rows, out uvec4 r[WIDE_PER_THREAD])
{
    [[unroll]] for (uint n = 0u; n < WIDE_PER_THREAD; ++n)
    {
        uint idx = n * wgSize + tid;
        if (idx < wgKv * DH4_PART / 2u)
        {
            uint c = idx / (DH4_PART / 2u), dp = 2u * (idx % (DH4_PART / 2u));
            uint i = (base + min(c, rows - 1u) * DH4 + dp) / 2u;
            r[n] = (which == 2u) ? bufferVCache_u4[i] : bufferV_u4[i];
        }
    }
}
void storeWide(uint tid, uvec4 r[WIDE_PER_THREAD])
{
    [[unroll]] for (uint n = 0u; n < WIDE_PER_THREAD; ++n)
    {
        uint idx = n * wgSize + tid;
        if (idx < wgKv * DH4_PART / 2u)
        {
            uint c = idx / (DH4_PART / 2u), dp = 2u * (idx % (DH4_PART / 2u));
            s_kv[c * KV_STRIDE + dp]      = halfLo(r[n]);
            s_kv[c * KV_STRIDE + dp + 1u] = halfHi(r[n]);
        }
    }
}

void stageWide(uint which, uint base, uint p, uint tid, uint rows)
{
    [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * DH4_PART / 2u; idx0 += wgSize)
    {
        uint idx = idx0 + tid;
        if (idx0 + wgSize <= wgKv * DH4_PART / 2u || idx < wgKv * DH4_PART / 2u)
        {
            uint c = idx / (DH4_PART / 2u), dp = 2u * (idx % (DH4_PART / 2u)), d = p * DH4_PART + dp;
            uint i = (base + min(c, rows - 1u) * DH4 + d) / 2u;
            uvec4 u = (which == 0u) ? bufferKCache_u4[i] : (which == 1u) ? bufferK_u4[i]
                    : (which == 2u) ? bufferVCache_u4[i] : bufferV_u4[i];
            s_kv[c * KV_STRIDE + dp]      = halfLo(u);
            s_kv[c * KV_STRIDE + dp + 1u] = halfHi(u);
        }
    }
}

// The K or V (isV) source of the staging below; isV is a constant at every call.
f16vec4 readKvCache4h(bool isV, uint i) { return isV ? readVCache4h(i) : readKCache4h(i); }
f16vec4 readKv4h(bool isV, uint i)      { return isV ? readV4h(i) : readK4h(i); }

// K or V tile, head-dim part p -> s_kv: a tile with one source (cacheTile, inputTile) copies from it, its
// rows clamped to the valid ones (see the header); the boundary tile, cached keys and new tokens in one,
// selects per element.
void stageKvPart(bool isV, uint jBase, uint p, bool cacheTile, bool inputTile, uint inputEnd,
                 uint kvCacheBase, uint kvInputBase, uint tid)
{
    const uint rows = min(wgKv, inputEnd - jBase);   // the tile's valid rows
    if (WIDE_KV && cacheTile && typeCache != DTYPE_F32)
    {
        stageWide(isV ? 2u : 0u, kvCacheBase + jBase * DH4, p, tid, rows);
    }
    else if (WIDE_KV && inputTile && typeKV != DTYPE_F32)
    {
        stageWide(isV ? 3u : 1u, kvInputBase + (jBase - kvCacheCount) * DH4, p, tid, rows);
    }
    else if (cacheTile)
    {
        [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * DH4_PART; idx0 += wgSize)
        {
            uint idx = idx0 + tid;
            if (idx0 + wgSize <= wgKv * DH4_PART || idx < wgKv * DH4_PART)
            {
                uint c = idx / DH4_PART, dp = idx % DH4_PART, d = p * DH4_PART + dp;
                s_kv[c * KV_STRIDE + dp] = (DH4_PAD == DH4 || d < DH4)
                    ? readKvCache4h(isV, kvCacheBase + (jBase + min(c, rows - 1u)) * DH4 + d) : f16vec4(0.0);
            }
        }
    }
    else if (inputTile)
    {
        [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * DH4_PART; idx0 += wgSize)
        {
            uint idx = idx0 + tid;
            if (idx0 + wgSize <= wgKv * DH4_PART || idx < wgKv * DH4_PART)
            {
                uint c = idx / DH4_PART, dp = idx % DH4_PART, d = p * DH4_PART + dp;
                s_kv[c * KV_STRIDE + dp] = (DH4_PAD == DH4 || d < DH4)
                    ? readKv4h(isV, kvInputBase + (jBase - kvCacheCount + min(c, rows - 1u)) * DH4 + d)
                    : f16vec4(0.0);
            }
        }
    }
    else
    {
        [[unroll]] for (uint idx0 = 0u; idx0 < wgKv * DH4_PART; idx0 += wgSize)
        {
            uint idx = idx0 + tid;
            if (idx0 + wgSize <= wgKv * DH4_PART || idx < wgKv * DH4_PART)
            {
                uint c = idx / DH4_PART, dp = idx % DH4_PART, d = p * DH4_PART + dp;
                uint j = jBase + c;
                f16vec4 v = f16vec4(0.0);
                if (DH4_PAD == DH4 || d < DH4)
                {
                    if (j < kvCacheCount)  v = readKvCache4h(isV, kvCacheBase + j * DH4 + d);
                    else if (j < inputEnd) v = readKv4h(isV, kvInputBase + (j - kvCacheCount) * DH4 + d);
                }
                s_kv[c * KV_STRIDE + dp] = v;
            }
        }
    }
}

void main()
{
    const uint split = gl_WorkGroupID.x % kCount;   // my KV split (scalar-kernel pattern)
    const uint qTile = gl_WorkGroupID.x / kCount;   // Q row-tile index; packed: token index
    const uint wgY   = gl_WorkGroupID.y;          // query head; packed: KV head
    const uint tid   = gl_LocalInvocationID.x;
    const uint sg    = gl_SubgroupID;
    const uint lane  = gl_SubgroupInvocationID;
    const bool packed = (gqaRatio > 1u);

    // The sequence rode in on the grid's z, which this kernel never used, so
    // the head index stays the model's and nothing has to be divided apart.
    const uint b           = gl_WorkGroupID.z;
    const uint qHeadBase   = b * Hq;
    const uint Hkv         = Hq / groupSize;   // KV heads one sequence's block holds
    const uint kvHead      = b * Hkv + (packed ? wgY : wgY / groupSize);
    const uint kvCacheBase = kvHead * Tmax  * DH4;   // vec4 units
    const uint kvInputBase = kvHead * Tkv * DH4;
    const uint rowBase     = sg * ROWS_PER_SG;   // my subgroup's softmax rows (tile-local)

    // Copy loops below use the `idx = idx0 + tid` compile-time-trip idiom so
    // [[unroll]] batches the loads (= ggml; measured essential on decode).
    // Q tile to shared (f16vec4, unscaled; invalid rows / d past Dh zero).
    // NOTE: ggml pre-scales here — vai post-scales S (keeps f16 Q exact,
    // same reasoning as the scalar kernel).
    [[unroll]] for (uint idx0 = 0u; idx0 < wgRows * DH4_PAD; idx0 += wgSize)
    {
        uint idx = idx0 + tid;
        if (idx0 + wgSize <= wgRows * DH4_PAD || idx < wgRows * DH4_PAD)
        {
            uint row = idx / DH4_PAD, d = idx % DH4_PAD;
            s_q[row * Q_STRIDE + d] = (ROW_VALID(row) && d < DH4)
                ? f16vec4(readQ4((qHeadBase + ROW_HEAD(row)) * Tq * DH4 + ROW_TOK(row) * DH4 + d)) : f16vec4(0.0);
        }
    }

    // Fused append (split 0; appendBeforeSweep: the LAST split — it is the
    // one that reads the token back). Non-packed: the KV-head-leader workgroup.
    // kvCaching == 0 skips it: the cache descriptors are null.
    if (kvCaching != 0u && packed && split == (appendBeforeSweep != 0u ? kCount - 1u : 0u)
        && qTile < Tkv)
    {
        [[unroll]] for (uint d = tid; d < DH4; d += wgSize)
        {
            uint src = kvInputBase + qTile * DH4 + d;
            uint dst = kvCacheBase + cacheRow(kvCacheCount + qTile) * DH4 + d;
            writeKCache4(dst, readK4(src));
            writeVCache4(dst, readV4(src));
        }
    }
    else if (kvCaching != 0u && !packed && split == 0u && wgY % groupSize == 0u)
    {
        [[unroll]] for (uint idx0 = 0u; idx0 < wgRows * DH4; idx0 += wgSize)
        {
            uint idx = idx0 + tid;
            if (idx0 + wgSize <= wgRows * DH4 || idx < wgRows * DH4)
            {
                uint row = idx / DH4, d = idx % DH4;
                uint tok = qTile * wgRows + row;
                if (tok < Tkv)
                {
                    uint src = kvInputBase + tok * DH4 + d;
                    uint dst = kvCacheBase + cacheRow(kvCacheCount + tok) * DH4 + d;
                    writeKCache4(dst, readK4(src));
                    writeVCache4(dst, readV4(src));
                }
            }
        }
    }
    // Tkv > Tq (no appendBeforeSweep): the rows past the grid's own, written by every split's Q tiles
    // (splitsAppendExtraKv) or by split 0's. The sweep reads the inputs, so nothing waits on these writes.
    if (splitsAppendExtraKv != 0u)
    {
        if (Tkv > Tq && kvCaching != 0u && (packed || wgY % groupSize == 0u))
        {
            const uint tileRows = packed ? 1u : wgRows;
            const uint gridRows = packed ? Tq : (Tq + wgRows - 1u) / wgRows * wgRows;
            const uint writers  = gl_NumWorkGroups.x;   // this head's Q tiles x splits
            for (uint first = gridRows + gl_WorkGroupID.x * tileRows; first < Tkv; first += writers * tileRows)
            {
                for (uint idx = tid; idx < tileRows * DH4; idx += wgSize)
                {
                    uint tok = first + idx / DH4, d = idx % DH4;
                    if (tok < Tkv)
                    {
                        uint src = kvInputBase + tok * DH4 + d;
                        uint dst = kvCacheBase + cacheRow(kvCacheCount + tok) * DH4 + d;
                        writeKCache4(dst, readK4(src));
                        writeVCache4(dst, readV4(src));
                    }
                }
            }
        }
    }
    else if (Tkv > Tq && kvCaching != 0u && split == 0u && (packed || wgY % groupSize == 0u))
    {
        const uint tileRows = packed ? 1u : wgRows;
        const uint gridRows = packed ? Tq : (Tq + wgRows - 1u) / wgRows * wgRows;
        for (uint first = qTile * tileRows + gridRows; first < Tkv; first += gridRows)
        {
            for (uint idx = tid; idx < tileRows * DH4; idx += wgSize)
            {
                uint tok = first + idx / DH4, d = idx % DH4;
                if (tok < Tkv)
                {
                    uint src = kvInputBase + tok * DH4 + d;
                    uint dst = kvCacheBase + cacheRow(kvCacheCount + tok) * DH4 + d;
                    writeKCache4(dst, readK4(src));
                    writeVCache4(dst, readV4(src));
                }
            }
        }
    }
    if (appendBeforeSweep != 0u)
        memoryBarrierBuffer();   // own append visible before the sweep reads it back
    barrier();   // s_q ready

    // Per-thread state: my subgroup's rows x my head-dim lane stripe, all fp32.
    float m[ROWS_PER_SG];
    float l[ROWS_PER_SG];
    vec4  acc32[ROWS_PER_SG * PV4_PER_LANE];
    float corr[ROWS_PER_SG];
    [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r) { m[r] = -1e30; l[r] = 0.0; }
    [[unroll]] for (uint x = 0u; x < ROWS_PER_SG * PV4_PER_LANE; ++x)
        acc32[x] = vec4(0.0);
    // PERSISTENT_O: my head-dim chunks {sg, sg + 4, ...} of O for every tile row.
    coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator> oacc[PERSISTENT_O ? OC_PER_SG : 1u];
    if (PERSISTENT_O)
        [[unroll]] for (uint i = 0u; i < OC_PER_SG; ++i)
            oacc[i] = coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>(0.0);

    // Unified KV sweep in global token coordinates: position j reads cache[j]
    // when j < cached, else input[j - cached]; only the boundary tile mixes
    // sources (appendBeforeSweep: the cache alone, the new token in the last split).
    {
        const uint inputEnd = kvCacheCount + Tkv;   // token count after append

        // Split-K: my span of the keys the tile reaches, which the tile's last
        // row bounds (keyEnd rises with the row); appendBeforeSweep spans the
        // cache's whole tiles (see the header). The span comes from the live cache, not
        // the host: the command buffer outlives the cache length it was
        // recorded at.
        const uint lastRowTok = packed ? qTile : min(Tq, qTile * wgRows + wgRows) - 1u;
        const uint tileEnd   = kvCacheCount + keyEnd(lastRowTok);
        const uint splitKeys = (appendBeforeSweep != 0u) ? kvCacheCount & ~(wgKv - 1u) : tileEnd;
        const uint lo        = spanOrigin(ROW_TOK(0u));   // spanned sweeps cut their splits from the span's start
        const uint splitSpan = ((((splitKeys - lo) + kCount - 1u) / kCount) + wgKv - 1u) & ~(wgKv - 1u);
        const uint spanStart = min(lo + split * splitSpan, splitKeys);
        const uint sweepEnd  = (split == kCount - 1u) ? tileEnd : min(splitKeys, spanStart + splitSpan);

        // skipEmptySplits: a span with no keys marks its partial slots empty (m = -1e30, l = -1) and
        // leaves. The busy splits are a prefix (plus the last split with appendBeforeSweep) that the
        // reduce folds alone. Workgroup-uniform; the barriers left are all past it.
        if (skipEmptySplits != 0u && spanStart >= sweepEnd)
        {
            for (uint row = tid; row < wgRows; row += wgSize)
                if (ROW_VALID(row))
                {
                    const uint rowIdx = outRow(ROW_TOK(row), ROW_HEAD(row));
                    partialML[(rowIdx * kCount + split) * 2u]      = -1e30;
                    partialML[(rowIdx * kCount + split) * 2u + 1u] = -1.0;
                }
            return;
        }

        // Spanned sweeps start at the bound of the tile's OLDEST row, so the
        // start stays workgroup-uniform and no split's end moves; the spans
        // must stay contiguous and disjoint. The start rounds down to a whole
        // tile, so no tile wraps a ring cache (see the scalar kernel).
        const uint winStart  = keyStart(keyPos(ROW_TOK(0u)));
        const uint jStart    = max(spanStart, winStart & ~(wgKv - 1u));

        // My 4 rows' ranges rise with the row: the first row ends them soonest,
        // the last starts them latest. A tile inside both bounds is whole to all
        // four and skips the exclusion compares.
        const uint rowsLo   = keyStart(keyPos(ROW_TOK(rowBase + 3u)));
        const uint rowsHi   = min(kvCacheCount + keyEnd(ROW_TOK(rowBase)) - 1u, sweepEnd - 1u);

        [[dont_unroll]]
        for (uint jBase = jStart; jBase < sweepEnd; jBase += wgKv)
        {
            // This tile's cache rows: one shift from its positions (ring), or none.
            const uint cacheBase = kvCacheBase - ((kvCacheRing != 0u) ? jBase - jBase % Tmax : 0u) * DH4;
            // Tile classes (workgroup-uniform): staged = vendor policy, any
            // padded-Dh shape, an f32 source, or the boundary/tail tile;
            // unstaged full tiles skip s_kv entirely. appendBeforeSweep folds
            // the classification to full-vs-tail (the appended token is
            // cache-readable).
            const bool fullCache  = jBase + wgKv
                                  <= (appendBeforeSweep != 0u ? inputEnd : kvCacheCount);
            const bool fullInput  = appendBeforeSweep == 0u
                                  && jBase >= kvCacheCount && jBase + wgKv <= inputEnd;
            // directLoadPaddedDh: input tiles only (a cache row past the count may be unwritten), and not the tile
            // holding the inputs' last row: its chunk past Dh would read past the tensor, and a pooled buffer
            // may be longer than its tensor, so those bytes are neither out of bounds nor zero.
            const bool lastInputTile = kvHead + 1u == gl_NumWorkGroups.z * Hkv && jBase + wgKv == inputEnd;
            const bool directLoadTile = (directLoadPaddedDh != 0u) && !fullCache && fullInput && !lastInputTile
                                    && typeKV != DTYPE_F32;
            const bool stagedTile = (shmemStaging != 0u) || ((DH4_PAD != DH4) && !directLoadTile)
                                  || !((fullCache && typeCache != DTYPE_F32) || (fullInput && typeKV != DTYPE_F32));
            // One-source tiles, whole or tail: every appendBeforeSweep tile reads the cache, a tile past the
            // cached keys reads the new tokens.
            const bool cacheTile  = appendBeforeSweep != 0u || fullCache;
            const bool inputTile  = appendBeforeSweep == 0u && jBase >= kvCacheCount;
            const uint tileRows   = min(wgKv, inputEnd - jBase);

            // (a) K tile, part 0 -> s_kv (the rest inside GEMM1); SMALL_KV
            // pipelines stage per chunk inside GEMM1/GEMM2 instead.
            if (stagedTile && !SMALL_KV)
            {
                barrier();   // previous tile's s_kv and s_s reads done
                stageKvPart(false, jBase, 0u, cacheTile, inputTile, inputEnd, cacheBase, kvInputBase, tid);
                barrier();
            }
            else if (!stagedTile)
                barrier();   // previous tile's s_s reads done

            // prefetchV: issue this tile's V part-0 loads now (full f16 tiles only).
            const bool vEarlyCache = PREFETCH_V && cacheTile && typeCache != DTYPE_F32;
            const bool vEarlyInput = PREFETCH_V && !cacheTile && inputTile && typeKV != DTYPE_F32;
            uvec4 vpre[WIDE_PER_THREAD];
            if (vEarlyCache)      loadWide(2u, cacheBase + jBase * DH4, tid, tileRows, vpre);
            else if (vEarlyInput) loadWide(3u, kvInputBase + (jBase - kvCacheCount) * DH4, tid, tileRows, vpre);

            // (b) GEMM1: my subgroup's 16 KV rows of S^T = K * Q^T; unstaged
            // full tiles load K straight from global. fp32 accumulator (see
            // the s_s declaration).
            {
                coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator> S =
                    coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>(0.0);
                [[unroll]] for (uint dc = 0u; dc < DH_CHUNKS; ++dc)
                {
                    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> A;
                    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> B;
                    if (stagedTile)
                    {
                        if (SMALL_KV)
                        {
                            // Boundary tile: stage this K chunk into the
                            // small buffer (prior s_kv readers are past the
                            // last workgroup barrier).
                            barrier();
                            stageKChunkSmall(jBase, dc, inputEnd, cacheBase, kvInputBase, tid);
                            barrier();
                            coopMatLoad(A, s_kv, (sg * MAT) * KB_STRIDE, KB_STRIDE,
                                        gl_CooperativeMatrixLayoutRowMajor);
                        }
                        else
                        {
                            if (dc > 0u && dc % CHUNKS_PART == 0u)   // next head-dim part
                            {
                                barrier();   // this part's reads done
                                stageKvPart(false, jBase, dc / CHUNKS_PART, cacheTile, inputTile, inputEnd, cacheBase, kvInputBase, tid);
                                barrier();
                            }
                            coopMatLoad(A, s_kv, (sg * MAT) * KV_STRIDE + dc * (MAT / 4u) - (dc / CHUNKS_PART) * DH4_PART,
                                        KV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        }
                    }
                    else if (appendBeforeSweep != 0u || fullCache)   // appendBeforeSweep: input branch statically dead
                        A = loadKDirect(true,
                                        cacheBase + (jBase + sg * MAT) * DH4 + dc * (MAT / 4u));
                    else
                        A = loadKDirect(false,
                                        kvInputBase + (jBase - kvCacheCount + sg * MAT) * DH4
                                                    + dc * (MAT / 4u));
                    coopMatLoad(B, s_q, dc * (MAT / 4u), Q_STRIDE,
                                gl_CooperativeMatrixLayoutColumnMajor);
                    S = coopMatMulAdd(A, B, S);
                }
                coopMatStore(S, s_s, (sg * MAT) * S_STRIDE, S_STRIDE,
                             gl_CooperativeMatrixLayoutRowMajor);
            }
            barrier();   // s_s ready; K reads done (s_kv reusable for V)

            // (c) Exclusion + exact-row-max online softmax on my rows; P -> s_p.
            // One barrier after covers both this and the V staging below.
            {
                // My 4 rows are exactly one vec4 group: each column costs one
                // vec4 read/write; S values stay in registers between passes.
                const uint rowVec = rowBase / 4u;
                const bool wholeTile = jBase >= rowsLo && jBase + wgKv - 1u <= rowsHi;

                vec4 sv[COLS_PER_LANE];
                vec4 rowMax = vec4(-1e30);
                [[unroll]] for (uint cl = 0u; cl < COLS_PER_LANE; ++cl)
                {
                    uint c = cl * sgSize + lane;
                    uint j = jBase + c;
                    // scale (with log2(e)) lands here, on the f32 S values.
                    vec4 v = s_s[c * S_STRIDE + rowVec] * (scale * LOG2E);
                    // Causality, span and range exclusion in one compare pair
                    // per row, on the tiles that cut a row's range: the sweepEnd
                    // term binds where the tile runs past my split's span.
                    if (!wholeTile)
                    {
                        [[unroll]] for (uint k = 0u; k < 4u; ++k)
                        {
                            uint rowTok = ROW_TOK(rowBase + k);
                            uint lo   = keyStart(keyPos(rowTok));
                            uint hi   = min(kvCacheCount + keyEnd(rowTok) - 1u, sweepEnd - 1u);
                            v[k] = (j <= hi && j >= lo) ? v[k] : NEG_INF;
                        }
                    }
                    sv[cl] = v;
                    rowMax = max(rowMax, v);
                }

                [[unroll]] for (uint k = 0u; k < 4u; ++k)
                {
                    float rm = subgroupMax(rowMax[k]) + QK_MAX_OFFSET;   // exact per tile
                    float mPrev = m[k];
                    // PERSISTENT_O: keep the reference until the tile outgrows it (first
                    // tile: mPrev = -1e30, so it moves and corr = 0).
                    m[k] = PERSISTENT_O ? ((rm > mPrev + RESCALE_LOG2) ? rm : mPrev) : max(rm, mPrev);
                    corr[k] = exp2(mPrev - m[k]);
                    l[k] *= corr[k];
                }
                if (PERSISTENT_O && lane == 0u)
                {
                    vec4 cvec;   // through the loop variable (spec-sized array, see mvec)
                    [[unroll]] for (uint k = 0u; k < 4u; ++k) cvec[k] = corr[k];
                    s_s[CORR_BASE + rowVec] = cvec;
                }

                // Built through the loop variable: glslang refuses literal
                // indexing of spec-constant-sized arrays.
                vec4 mvec;
                [[unroll]] for (uint k = 0u; k < 4u; ++k) mvec[k] = m[k];
                [[unroll]] for (uint cl = 0u; cl < COLS_PER_LANE; ++cl)
                {
                    uint c = cl * sgSize + lane;
                    vec4 p4 = exp2(sv[cl] - mvec);   // -inf -> exact 0
                    [[unroll]] for (uint k = 0u; k < 4u; ++k) l[k] += p4[k];
                    s_p[c * P_STRIDE + rowVec] = f16vec4(p4);
                }
            }
            // V tile, part 0: as (a); unstaged full tiles skip it, SMALL_KV
            // boundary tiles stage per GEMM2 pass inside (d).
            if (vEarlyCache || vEarlyInput)
                storeWide(tid, vpre);
            else if (stagedTile && !SMALL_KV)
                stageKvPart(true, jBase, 0u, cacheTile, inputTile, inputEnd, cacheBase, kvInputBase, tid);
            barrier();   // s_p and V staging ready

            // (d) GEMM2: my subgroup's head-dim chunks of PV = P * V; unstaged
            // full tiles load V straight from global.
            if (SMALL_KV && stagedTile)
            {
                // Boundary tile with the small buffer: GEMM2 runs in passes of
                // VP_CHUNKS chunks — stage the pass's V columns, then subgroup sg
                // (< VP_CHUNKS) takes chunk pass*VP_CHUNKS + sg.
                const uint VP = (DH_CHUNKS + VP_CHUNKS - 1u) / VP_CHUNKS;
                for (uint pass = 0u; pass < VP; ++pass)
                {
                    barrier();   // prior pass's V reads (pass 0: GEMM1's K chunk reads) done
                    if (DRAIN_PARTS > 1u && pass * VP_CHUNKS >= CHUNKS_DRAIN && (pass * VP_CHUNKS) % CHUNKS_DRAIN == 0u)
                        PULL_PV(pass * VP_CHUNKS / CHUNKS_DRAIN - 1u);   // the previous drain part is complete
                    stageVPassSmall(jBase, pass, inputEnd, cacheBase, kvInputBase, tid);
                    barrier();
                    uint dc = pass * VP_CHUNKS + sg;
                    if (sg < VP_CHUNKS && dc < DH_CHUNKS)
                    {
                        coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator> PV =
                            coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>(0.0);
                        [[unroll]] for (uint kc = 0u; kc < KV_CHUNKS; ++kc)
                        {
                            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> A;
                            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> B;
                            coopMatLoad(A, s_p, (kc * MAT) * P_STRIDE, P_STRIDE,
                                        gl_CooperativeMatrixLayoutColumnMajor);
                            coopMatLoad(B, s_kv, (kc * MAT) * VS_STRIDE + sg * (MAT / 4u), VS_STRIDE,
                                        gl_CooperativeMatrixLayoutRowMajor);
                            PV = coopMatMulAdd(A, B, PV);
                        }
                        coopMatStore(PV, s_s, (dc % CHUNKS_DRAIN) * (MAT / 4u), PV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    }
                }
            }
            else if (PERSISTENT_O)
            {
                // Rescale my O chunks if any row's reference moved (0 < corr < 1): workgroup-uniform, a
                // chunk round-trips through s_s (S^T reads are done).
                bool rescale = false;
                [[unroll]] for (uint q = 0u; q < wgRows / 4u; ++q)
                {
                    const vec4 c4 = s_s[CORR_BASE + q];
                    [[unroll]] for (uint k = 0u; k < 4u; ++k)
                        rescale = rescale || (c4[k] > 0.0 && c4[k] < 1.0);
                }
                if (rescale)
                    [[unroll]] for (uint i = 0u; i < OC_PER_SG; ++i)
                    {
                        const uint dc = sg + i * NUM_SG;
                        if (dc < DH_CHUNKS)
                        {
                            const uint col = (dc % CHUNKS_PART) * (MAT / 4u);
                            coopMatStore(oacc[i], s_s, col, PV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                            subgroupMemoryBarrierShared();
                            subgroupBarrier();
                            for (uint e = lane; e < MAT * (MAT / 4u); e += sgSize)
                            {
                                const uint row = e / (MAT / 4u);
                                s_s[row * PV_STRIDE + col + e % (MAT / 4u)] *= s_s[CORR_BASE + row / 4u][row % 4u];
                            }
                            subgroupMemoryBarrierShared();
                            subgroupBarrier();
                            coopMatLoad(oacc[i], s_s, col, PV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                        }
                    }
                // O += P * V straight into the accumulators.
                [[unroll]] for (uint i = 0u; i < OC_PER_SG; ++i)
                {
                    const uint dc = sg + i * NUM_SG;
                    if (dc < DH_CHUNKS)
                    {
                        // Next part; CHUNKS_PART % NUM_SG == 0, so all subgroups cross together.
                        if (dc >= CHUNKS_PART && (dc - sg) % CHUNKS_PART == 0u)
                        {
                            barrier();   // this part's V reads done
                            stageKvPart(true, jBase, dc / CHUNKS_PART, cacheTile, inputTile, inputEnd, cacheBase, kvInputBase, tid);
                            barrier();
                        }
                        [[unroll]] for (uint kc = 0u; kc < KV_CHUNKS; ++kc)
                        {
                            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> A;
                            coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> B;
                            coopMatLoad(A, s_p, (kc * MAT) * P_STRIDE, P_STRIDE,
                                        gl_CooperativeMatrixLayoutColumnMajor);
                            coopMatLoad(B, s_kv, (kc * MAT) * KV_STRIDE + dc * (MAT / 4u) - (dc / CHUNKS_PART) * DH4_PART,
                                        KV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                            oacc[i] = coopMatMulAdd(A, B, oacc[i]);
                        }
                    }
                }
            }
            else
            for (uint dc = sg; dc < DH_CHUNKS; dc += NUM_SG)
            {
                // Next drain part (staged: and V part); CHUNKS_DRAIN % NUM_SG == 0, so all subgroups cross together.
                if (DRAIN_PARTS > 1u && dc >= CHUNKS_DRAIN && (dc - sg) % CHUNKS_DRAIN == 0u)
                {
                    barrier();   // this part's reads and P.V stores done
                    PULL_PV(dc / CHUNKS_DRAIN - 1u);
                    if (KV_PARTS > 1u)
                        stageKvPart(true, jBase, dc / CHUNKS_PART, cacheTile, inputTile, inputEnd, cacheBase, kvInputBase, tid);
                    barrier();
                }
                coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator> PV =
                    coopmat<float, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseAccumulator>(0.0);
                [[unroll]] for (uint kc = 0u; kc < KV_CHUNKS; ++kc)
                {
                    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseA> A;
                    coopmat<float16_t, gl_ScopeSubgroup, MAT, MAT, gl_MatrixUseB> B;
                    coopMatLoad(A, s_p, (kc * MAT) * P_STRIDE, P_STRIDE,
                                gl_CooperativeMatrixLayoutColumnMajor);
                    if (!SMALL_KV && stagedTile)   // SMALL_KV boundary took the pass loop above
                        coopMatLoad(B, s_kv, (kc * MAT) * KV_STRIDE + dc * (MAT / 4u) - (dc / CHUNKS_PART) * DH4_PART,
                                    KV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
                    else if (appendBeforeSweep != 0u || fullCache)   // appendBeforeSweep: input branch statically dead
                        B = loadVDirect(true,
                                        cacheBase + (jBase + kc * MAT) * DH4 + dc * (MAT / 4u));
                    else
                        B = loadVDirect(false,
                                        kvInputBase + (jBase - kvCacheCount + kc * MAT) * DH4
                                                    + dc * (MAT / 4u));
                    PV = coopMatMulAdd(A, B, PV);
                }
                coopMatStore(PV, s_s, (dc % CHUNKS_DRAIN) * (MAT / 4u), PV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }
            if (!PERSISTENT_O)
            {
                barrier();   // P.V (last part) in s_s ready

                // (e) Pull the last part's P.V into acc.
                PULL_PV(DRAIN_PARTS - 1u);
            }
        }
    }

    // PERSISTENT_O: drain O into acc once, part by part (the epilogue below is shared).
    if (PERSISTENT_O)
        [[unroll]] for (uint part = 0u; part < KV_PARTS; ++part)
        {
            barrier();   // the sweep's s_s use is over (or the previous part read)
            [[unroll]] for (uint i = 0u; i < OC_PER_SG; ++i)
            {
                const uint dc = sg + i * NUM_SG;
                if (dc < DH_CHUNKS && dc / CHUNKS_PART == part)
                    coopMatStore(oacc[i], s_s, (dc % CHUNKS_PART) * (MAT / 4u), PV_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
            }
            barrier();
            [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r)
                [[unroll]] for (uint k = 0u; k < PV4_PER_LANE; ++k)
                {
                    uint d = k * sgSize + lane;
                    if (d < DH4 && d >= part * DH4_PART && d < part * DH4_PART + DH4_PART)
                        acc32[r * PV4_PER_LANE + k] = s_s[(rowBase + r) * PV_STRIDE + d - part * DH4_PART];
                }
        }

    // Epilogue: l is striped across the subgroup's lanes (one subgroupAdd);
    // acc is not (each lane owns disjoint head-dim columns).
    [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r)
        l[r] = subgroupAdd(l[r]);

    if (kCount > 1u)
    {
        // Split partials: same layout as the scalar kernel, folded by the
        // same reduce pass; empty splits naturally write (m=-1e30, l=0, acc=0)
        // (skipEmptySplits: the ones past the keys left above with l = -1).
        [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r)
        {
            uint row = rowBase + r;
            if (!ROW_VALID(row)) continue;
            uint rowIdx = outRow(ROW_TOK(row), ROW_HEAD(row));
            [[unroll]] for (uint k = 0u; k < PV4_PER_LANE; ++k)
            {
                uint d = k * sgSize + lane;
                if (d < DH4)
                    partialO[(rowIdx * kCount + split) * DH4 + d] = acc32[r * PV4_PER_LANE + k];
            }
            if (lane == 0u)
            {
                partialML[(rowIdx * kCount + split) * 2u]      = m[r] * LN2;   // natural units for the reduce
                partialML[(rowIdx * kCount + split) * 2u + 1u] = l[r];
            }
        }
        return;
    }

    // Normalize and store (token-major).
    [[unroll]] for (uint r = 0u; r < ROWS_PER_SG; ++r)
    {
        uint row = rowBase + r;
        if (!ROW_VALID(row)) continue;
        float lInv = (l[r] == 0.0) ? 0.0 : (1.0 / l[r]);
        [[unroll]] for (uint k = 0u; k < PV4_PER_LANE; ++k)
        {
            uint d = k * sgSize + lane;
            if (d < DH4)
                writeO4(outRow(ROW_TOK(row), ROW_HEAD(row)) * DH4 + d, acc32[r * PV4_PER_LANE + k] * lInv);
        }
    }
}
