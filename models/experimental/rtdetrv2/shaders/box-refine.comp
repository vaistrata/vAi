/*=============================================================================
 box-refine.comp:
 Refine normalized boxes: sigmoid(delta + inverse_sigmoid(boxes)).
 Inputs/output: FP32 [Q, 4]. N is the total element count. Dispatch: dispatch2(N).
=============================================================================*/
#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 1) readonly buffer BOX_BUF { float boxes[]; };
layout(set = 0, binding = 2) readonly buffer DELTA_BUF { float delta[]; };

layout(push_constant) uniform PushConstants { uint N; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= N) return;

    float box = clamp(boxes[i], 0.0, 1.0);
    float logit = log(max(box, 1e-5) / max(1.0 - box, 1e-5));
    bufferO_f32[i] = 1.0 / (1.0 + exp(-delta[i] - logit));
}
