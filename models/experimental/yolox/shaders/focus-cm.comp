/*=============================================================================
 YOLOX Focus + Conv-BN-SiLU, FP16 cooperative-matrix implicit GEMM.
 The packed weight represents the equivalent [Co, Ci, 6, 6] convolution while
 the input is read directly from [Ci, 2*Ho, 2*Wo].
 Bindings: O=0, I=1, packed W=2, BIAS=3, SCALE=4.
=============================================================================*/
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

#include "common/activation.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint wgSize = 128u;
layout(constant_id = 1) const uint wgMSize = 32u;
layout(constant_id = 2) const uint wgNSize = 32u;
layout(constant_id = 3) const uint panelK = 32u;
layout(constant_id = 4) const uint sgMSize = 16u;
layout(constant_id = 5) const uint sgNSize = 16u;
layout(constant_id = 6) const bool rowAlignedInput = false;
layout(constant_id = 7) const bool sharedInputPatch = false;
layout(constant_id = SPEC_ID_TYPE_CI) const uint CI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_CO) const uint CO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_HI) const uint HI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_HO) const uint HO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_WI) const uint WI_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_WO) const uint WO_SPEC = 0u;
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = DTYPE_F32;
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = DTYPE_F32;
layout(constant_id = SPEC_ID_TYPE_P) const uint typeP = DTYPE_F32;
layout(constant_id = SPEC_ID_TYPE_ACC) const uint typeAcc = DTYPE_F32;
layout(constant_id = SPEC_ID_HAS_SCALE) const uint hasScale = 1u;
layout(constant_id = SPEC_ID_HAS_BIAS) const uint hasBias = 1u;

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bI_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_2F16 { f16vec2 bI_2f16[]; };
layout(set = 0, binding = 2) restrict readonly buffer W_BUF_F16 { float16_t bW_f16[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F32 { float bBias_f32[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F16 { float16_t bBias_f16[]; };
layout(set = 0, binding = 4) restrict readonly buffer SCALE_BUF_F32 { float bScale_f32[]; };
layout(set = 0, binding = 4) restrict readonly buffer SCALE_BUF_F16 { float16_t bScale_f16[]; };

layout(push_constant) uniform PushConstants {
    uint hi; uint wi; uint ho; uint wo; uint ci; uint co;
    uint n; uint splitCount; uint kernel; uint stride;
    uint batch;             // vai::node::PushConstants' images
} pc;

const uint tM = 16u, tN = 16u, tK = 16u;
const uint sgCountM = wgMSize / sgMSize;
const uint sgCountN = wgNSize / sgNSize;
const uint sgCount = sgCountM * sgCountN;
const uint CM_TILE_ELEMS = tM * tN;
const uint patchWidth = 2u * wgNSize + 4u;
const uint patchElements = 18u * patchWidth;

// Keep inactive shared allocations 16-byte-sized for cooperative-matrix alignment.
shared float Cs32[sharedInputPatch ? 4u : (typeAcc == DTYPE_F32 ? sgCount * CM_TILE_ELEMS : CM_TILE_ELEMS)];
shared float16_t Cs16[!sharedInputPatch && typeAcc == DTYPE_F16 ? sgCount * CM_TILE_ELEMS : 8u];
shared float16_t Bs[panelK * wgNSize];
shared float16_t inputPatch[sharedInputPatch ? patchElements : 8u];

#define matA coopmat<float16_t, gl_ScopeSubgroup, tM, tK, gl_MatrixUseA>
#define matB coopmat<float16_t, gl_ScopeSubgroup, tK, tN, gl_MatrixUseB>
#define accMat16 coopmat<float16_t, gl_ScopeSubgroup, tM, tN, gl_MatrixUseAccumulator>
#define accMat32 coopmat<float, gl_ScopeSubgroup, tM, tN, gl_MatrixUseAccumulator>

layout(constant_id = 20) const bool batched = false;
uint inputBase() { return batched ? gl_WorkGroupID.z * pc.ci * pc.hi * pc.wi : 0u; }
uint outputBase() { return batched ? gl_WorkGroupID.z * pc.co * pc.ho * pc.wo : 0u; }

float readI(uint index)
{
    index += inputBase();
    return typeI == DTYPE_F32 ? bI_f32[index] : float(bI_f16[index]);
}
float readBias(uint c)
{
    if (hasBias == 0u) return 0.0;
    return typeP == DTYPE_F32 ? bBias_f32[c] : float(bBias_f16[c]);
}
float readScale(uint c) { return typeP == DTYPE_F32 ? bScale_f32[c] : float(bScale_f16[c]); }
void writeO(uint index, float value)
{
    index += outputBase();
    if (typeO == DTYPE_F32) bO_f32[index] = value;
    else bO_f16[index] = float16_t(value);
}

float readFocusInput(uint k, uint n, uint Hi, uint Wi, uint Wo, uint Ci)
{
    const uint inputChannel = k / 36u;
    const uint tap6 = k - inputChannel * 36u;
    const uint kh6 = tap6 / 6u;
    const uint kw6 = tap6 - kh6 * 6u;
    const uint hOut = n / Wo;
    const uint wOut = n - hOut * Wo;
    const int hIn = int(2u * hOut + kh6) - 2;
    const int wIn = int(2u * wOut + kw6) - 2;
    const uint physicalHi = 2u * Hi;
    const uint physicalWi = 2u * Wi;
    if (inputChannel >= Ci / 4u || hIn < 0 || wIn < 0 ||
        hIn >= int(physicalHi) || wIn >= int(physicalWi))
        return 0.0;
    return readI((inputChannel * physicalHi + uint(hIn)) * physicalWi + uint(wIn));
}

float finishOutput(uint channel, float value)
{
    value = hasScale == 0u
        ? value + readBias(channel)
        : fma(value, readScale(channel), readBias(channel));
    return applyActivation(value);
}

void fillB(uint panelBase, uint rawK, uint N, uint Hi, uint Wi, uint Wo, uint Ci, uint nBase)
{
    // A tile that divides Wo stays within one output row. Hoist row arithmetic
    // out of each B element. Keep the existing 64x16 path enabled by default;
    // other tiles opt in through a compile-time specialization.
    if ((rowAlignedInput || (wgMSize == 64u && wgNSize == 16u && panelK == 112u)) && (Wo % wgNSize) == 0u)
    {
        const uint hOut = nBase / Wo;
        const uint wBase = nBase - hOut * Wo;
        const uint physicalHi = 2u * Hi;
        const uint physicalWi = 2u * Wi;
        const uint kLane = gl_LocalInvocationID.x / wgNSize;
        const uint nLocal = gl_LocalInvocationID.x - kLane * wgNSize;
        const uint kStride = wgSize / wgNSize;
        for (uint kLocal = kLane; kLocal < panelK; kLocal += kStride)
        {
            const uint index = kLocal * wgNSize + nLocal;
            const uint k = panelBase + kLocal;
            const uint n = nBase + nLocal;
            float value = 0.0;
            if (k < rawK && n < N)
            {
                const uint inputChannel = k / 36u;
                const uint tap6 = k - inputChannel * 36u;
                const uint kh6 = tap6 / 6u;
                const uint kw6 = tap6 - kh6 * 6u;
                const int hIn = int(2u * hOut + kh6) - 2;
                const int wIn = int(2u * (wBase + nLocal) + kw6) - 2;
                if (inputChannel < Ci / 4u && hIn >= 0 && wIn >= 0 &&
                    hIn < int(physicalHi) && wIn < int(physicalWi))
                    value = readI((inputChannel * physicalHi + uint(hIn)) * physicalWi + uint(wIn));
            }
            Bs[index] = float16_t(value);
        }
        return;
    }

    for (uint index = gl_LocalInvocationID.x; index < panelK * wgNSize; index += wgSize)
    {
        const uint kLocal = index / wgNSize;
        const uint nLocal = index - kLocal * wgNSize;
        const uint k = panelBase + kLocal;
        const uint n = nBase + nLocal;
        Bs[index] = float16_t(k < rawK && n < N
            ? readFocusInput(k, n, Hi, Wi, Wo, Ci) : 0.0);
    }
}

void runSharedInputPatch()
{
    const uint Ho = HO_SPEC != 0u ? HO_SPEC : pc.ho;
    const uint Wo = WO_SPEC != 0u ? WO_SPEC : pc.wo;
    const uint N = Ho * Wo;
    const uint wgIdN = gl_WorkGroupID.x;
    const uint nBase = wgIdN * wgNSize;
    const uint outRow = nBase / Wo;
    const uint outColumn = nBase % Wo;
    // The selected tile divides Wo; each workgroup stays within one output row.
    for (uint pair = gl_LocalInvocationID.x; pair < patchElements / 2u; pair += wgSize)
    {
        uint row = pair / (patchWidth / 2u);
        int y = int(2u * outRow + row % 6u) - 2;
        int x = int(2u * outColumn + 2u * (pair % (patchWidth / 2u))) - 2;
        f16vec2 value = f16vec2(0.0);
        // RGB dimensions and every pair's starting column are even.
        if (uint(y) < 2u * Ho && uint(x) < 2u * Wo)
        {
            const uint index = inputBase() + ((row / 6u) * (2u * Ho) + uint(y)) * (2u * Wo) + uint(x);
            value = typeI == DTYPE_F32
                ? f16vec2(bI_f32[index], bI_f32[index + 1u])
                : bI_2f16[index / 2u];
        }
        inputPatch[2u * pair] = value.x;
        inputPatch[2u * pair + 1u] = value.y;
    }
    barrier();

    const uint sgIdx = gl_SubgroupID;
    const uint sgIdM = sgIdx / sgCountN;
    const uint sgIdN = sgIdx % sgCountN;
    const uint wgIdM = gl_WorkGroupID.y;
    const uint m0 = wgIdM * wgMSize + sgIdM * sgMSize;
    const uint n0 = nBase + sgIdN * sgNSize;
    accMat32 acc = accMat32(0.0);
    // RGB Focus has 3*6*6=108 coefficients, padded to seven native K16 tiles.
    for (uint panelBase = 0u; panelBase < 112u; panelBase += panelK)
    {
        for (uint index = gl_LocalInvocationID.x; index < panelK * wgNSize; index += wgSize)
        {
            uint k = panelBase + index / wgNSize;
            float16_t value = float16_t(0.0);
            if (k < 108u)
                value = inputPatch[(k / 6u) * patchWidth + 2u * (index % wgNSize) + k % 6u];
            Bs[index] = value;
        }
        barrier();
        for (uint kLocal = 0u; kLocal < panelK; kLocal += 16u)
        {
            matA a = matA(float16_t(0.0));
            if (panelBase + kLocal < 112u)
                coopMatLoad(a, bW_f16, ((m0 / 16u) * 7u + (panelBase + kLocal) / 16u) * 256u, 16u,
                            gl_CooperativeMatrixLayoutRowMajor);
            matB b;
            coopMatLoad(b, Bs, kLocal * wgNSize + sgIdN * sgNSize, wgNSize,
                        gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(a, b, acc);
        }
        // Bs is overwritten only between panels; the final panel needs no barrier.
        if (panelBase + panelK < 112u)
            barrier();
    }
    accMat16 bh;
    accMat16 sh;
    coopMatLoad(bh, bBias_f16, m0, 0u, gl_CooperativeMatrixLayoutColumnMajor);
    coopMatLoad(sh, bScale_f16, m0, 0u, gl_CooperativeMatrixLayoutColumnMajor);
    accMat32 b = accMat32(bh);
    accMat32 s = accMat32(sh);
    [[unroll]]
    for (int element = 0; element < acc.length(); element++)
        acc[element] = applyActivation(fma(acc[element], s[element], b[element]));
    if (typeO == DTYPE_F32)
        coopMatStore(acc, bO_f32, outputBase() + m0 * N + n0, N, gl_CooperativeMatrixLayoutRowMajor);
    else
    {
        accMat16 result = accMat16(acc);
        coopMatStore(result, bO_f16, outputBase() + m0 * N + n0, N, gl_CooperativeMatrixLayoutRowMajor);
    }
}


void main()
{
    if (sharedInputPatch)
    {
        runSharedInputPatch();
        return;
    }

    const uint Hi = HI_SPEC != 0u ? HI_SPEC : pc.hi;
    const uint Wi = WI_SPEC != 0u ? WI_SPEC : pc.wi;
    const uint Ho = HO_SPEC != 0u ? HO_SPEC : pc.ho;
    const uint Wo = WO_SPEC != 0u ? WO_SPEC : pc.wo;
    const uint Ci = CI_SPEC != 0u ? CI_SPEC : pc.ci;
    const uint Co = CO_SPEC != 0u ? CO_SPEC : pc.co;
    const uint N = Ho * Wo;
    const uint rawK = Ci * 9u;
    const uint paddedK = ((rawK + 15u) / 16u) * 16u;
    const uint kTiles = paddedK / 16u;
    const uint sgIdx = gl_SubgroupID;
    const uint sgIdM = sgIdx / sgCountN;
    const uint sgIdN = sgIdx - sgIdM * sgCountN;
    const uint wgIdM = gl_WorkGroupID.y;
    const uint m0 = wgIdM * wgMSize + sgIdM * sgMSize;
    const uint wgIdN = gl_WorkGroupID.x;
    const uint n0 = wgIdN * wgNSize + sgIdN * sgNSize;
    const uint mTile = m0 / 16u;

    if (typeAcc == DTYPE_F16)
    {
        accMat16 acc = accMat16(float16_t(0.0));
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, N, Hi, Wi, Wo, Ci, wgIdN * wgNSize);
            barrier();
            for (uint kLocal = 0u; kLocal < panelK; kLocal += 16u)
            {
                matA a = matA(float16_t(0.0));
                matB b;
                if (panelBase + kLocal < paddedK)
                    coopMatLoad(a, bW_f16, (mTile * kTiles + (panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b, Bs, kLocal * wgNSize + sgIdN * sgNSize, wgNSize, gl_CooperativeMatrixLayoutRowMajor);
                acc = coopMatMulAdd(a, b, acc);
            }
            barrier();
        }
        const uint sharedBase = sgIdx * CM_TILE_ELEMS;
        coopMatStore(acc, Cs16, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < CM_TILE_ELEMS; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u; const uint n = n0 + i % 16u;
            if (m < Co && n < N) writeO(m * N + n, finishOutput(m, float(Cs16[sharedBase + i])));
        }
    }
    else
    {
        accMat32 acc = accMat32(0.0);
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, N, Hi, Wi, Wo, Ci, wgIdN * wgNSize);
            barrier();
            for (uint kLocal = 0u; kLocal < panelK; kLocal += 16u)
            {
                matA a = matA(float16_t(0.0));
                matB b;
                if (panelBase + kLocal < paddedK)
                    coopMatLoad(a, bW_f16, (mTile * kTiles + (panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b, Bs, kLocal * wgNSize + sgIdN * sgNSize, wgNSize, gl_CooperativeMatrixLayoutRowMajor);
                acc = coopMatMulAdd(a, b, acc);
            }
            barrier();
        }
        const uint sharedBase = sgIdx * CM_TILE_ELEMS;
        coopMatStore(acc, Cs32, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < CM_TILE_ELEMS; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u; const uint n = n0 + i % 16u;
            if (m < Co && n < N) writeO(m * N + n, finishOutput(m, Cs32[sharedBase + i]));
        }
    }
}
