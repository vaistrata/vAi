/*=============================================================================
 conv-transpose-1d.comp: transposed 1D convolution (torch.nn.ConvTranspose1d)
     O[co, t] = act(bias[co] + Σ_ci Σ_j W[ci, co, j] · I[ci, s]),
                over the taps j with t + pad − j = s · stride, 0 <= s < Ti

 Each output gathers the inputs that scatter into it, so no two threads write
 one element. Only ceil(K / stride) taps of the K reach an output (k4 s2: two),
 picked once per thread ahead of the Ci loop. Accumulation is fp32.
 - O (typeO), I (typeI) are fp32 or fp16; W (typeW) and bias (typeP) as loaded.
 One thread per (co, t), t fastest; dispatch z is the sequence.
 Bindings: O=0, I=1, W=2, BIAS=3.
 Dispatch (host): dispatch(ceil(Co · To / 64), 1, sequences).
 Push constants: Ci, Co, Ti, To.
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#include "common/activation.h"

#define MAX_TAPS 8u   // ceil(K / stride) the host allows

layout(local_size_x = 64) in;

layout(constant_id = 0) const uint K = 4u;          // kernel size
layout(constant_id = 1) const uint stride = 2u;
layout(constant_id = 2) const uint pad = 1u;
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0u;
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0u;
layout(constant_id = SPEC_ID_TYPE_W) const uint typeW = 0u;
layout(constant_id = SPEC_ID_TYPE_P) const uint typeP = 0u;
layout(constant_id = SPEC_ID_HAS_BIAS) const uint hasBias = 1u;

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };
layout(set = 0, binding = 2) restrict readonly buffer W_BUF_F32 { float bufferW_f32[]; };
layout(set = 0, binding = 2) restrict readonly buffer W_BUF_F16 { float16_t bufferW_f16[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F32 { float bufferBias_f32[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F16 { float16_t bufferBias_f16[]; };

layout(push_constant) uniform PushConstants {
    uint Ci;
    uint Co;
    uint Ti;
    uint To;    // (Ti − 1) · stride − 2 · pad + K
};

float readI(uint i)    { return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
float readW(uint i)    { return (typeW == DTYPE_F32) ? bufferW_f32[i] : float(bufferW_f16[i]); }
float readBias(uint c) { return (hasBias == 0u) ? 0.0 : ((typeP == DTYPE_F32) ? bufferBias_f32[c] : float(bufferBias_f16[c])); }
void  writeO(uint i, float v) { if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

void main()
{
    const uint e = gl_GlobalInvocationID.x;
    if (e >= Co * To) return;

    const uint seq = gl_WorkGroupID.z;
    const uint co = e / To;
    const uint t = e - co * To;
    const uint inBase = seq * Ci * Ti;

    // The taps reaching t: j with (t + pad − j) a multiple of stride, its s in range.
    uint tapJ[MAX_TAPS];
    uint tapS[MAX_TAPS];
    uint taps = 0u;
    for (uint j = 0u; j < K; ++j)
    {
        const int num = int(t + pad) - int(j);
        if (num < 0 || (uint(num) % stride) != 0u) continue;
        const uint s = uint(num) / stride;
        if (s >= Ti) continue;
        tapJ[taps] = j;
        tapS[taps] = s;
        ++taps;
    }

    float acc = 0.0;
    for (uint ci = 0u; ci < Ci; ++ci)
    {
        const uint wRow = (ci * Co + co) * K;   // W [Ci, Co, K]
        const uint iRow = inBase + ci * Ti;
        for (uint q = 0u; q < taps; ++q)
            acc += readW(wRow + tapJ[q]) * readI(iRow + tapS[q]);
    }

    writeO(seq * Co * To + e, applyActivation(acc + readBias(co)));
}
