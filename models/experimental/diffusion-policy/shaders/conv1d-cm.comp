/*=============================================================================
 conv1d-cm.comp: FP16 cooperative-matrix implicit-GEMM 1D convolution
     O[co, t] = act(Σ_{ci, j} W[co, ci, j] · I[ci, t·stride + j − K/2] + bias[co]) (+ R[co, t])

 A GEMM of M = Co, N = To over the reduction k = ci·K + j (Ci·K long). The
 input is gathered (implicit im2col) into shared memory one panel at a time,
 zero outside [0, Ti) (same padding K/2, K odd), so it is never expanded.

 - A: W packed once by conv1d-cm-transform into 16x16 row-major fragments,
   [Mp/16][Kp/16][16][16], tails zero-filled.
 - B: the gathered input panel, [panelK][wgN] fp16 in shared memory.
 - A subgroup owns one 16x16 output tile; wgM / 16 x wgN / 16 subgroups of 32
   lanes (host pins the subgroup size) cover a workgroup's wgM x wgN tile. A
   subgroup whose rows start past Co (Co < wgM) fills B and meets every barrier
   but loads no fragment.
 - accF32 1: fp32 accumulators, 0: fp16.
 - O (typeO), I / R (typeI) are fp32 or fp16; bias (typeP) as the loader stored it.
 Bindings: O=0, I=1, Wp=2, BIAS=3, RESIDUAL=4.
 Dispatch (host): x = ceil(To / wgN), y = ceil(Co / wgM), z = sequences.
 Push constants: Ci, Co, Ti, To.
=============================================================================*/
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

#include "common/activation.h"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint wgSize = 128u;
layout(constant_id = 1) const uint wgM = 64u;
layout(constant_id = 2) const uint wgN = 16u;
layout(constant_id = 3) const uint panelK = 32u;          // a multiple of 16
layout(constant_id = 4) const uint K = 1u;                // kernel size, odd
layout(constant_id = 5) const uint stride = 1u;
layout(constant_id = 6) const uint accF32 = 1u;           // 1: fp32 accumulators, 0: fp16
layout(constant_id = 7) const uint hasResidual = 0u;
layout(constant_id = 8) const uint residualOrder = 0u;    // 0: after the activation, 1: before it
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0u;
layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 0u;
layout(constant_id = SPEC_ID_TYPE_P) const uint typeP = 0u;
layout(constant_id = SPEC_ID_HAS_BIAS) const uint hasBias = 1u;

layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F32 { float bufferO_f32[]; };
layout(set = 0, binding = 0) restrict writeonly buffer O_BUF_F16 { float16_t bufferO_f16[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F32 { float bufferI_f32[]; };
layout(set = 0, binding = 1) restrict readonly buffer I_BUF_F16 { float16_t bufferI_f16[]; };
layout(set = 0, binding = 2) restrict readonly buffer W_BUF_F16 { float16_t bufferW_f16[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F32 { float bufferBias_f32[]; };
layout(set = 0, binding = 3) restrict readonly buffer BIAS_BUF_F16 { float16_t bufferBias_f16[]; };
layout(set = 0, binding = 4) restrict readonly buffer RES_BUF_F32 { float bufferRes_f32[]; };
layout(set = 0, binding = 4) restrict readonly buffer RES_BUF_F16 { float16_t bufferRes_f16[]; };

layout(push_constant) uniform PushConstants {
    uint Ci;
    uint Co;
    uint Ti;    // input length
    uint To;    // output length, (Ti - 1) / stride + 1
};

const uint tile = 16u;
const uint subgroupSize = 32u;
const uint subgroupCount = wgSize / subgroupSize;
const uint tileElements = tile * tile;
// An FP32 scratch tile ahead of the FP16 one keeps NVIDIA's FP16 coopMatStore
// base aligned (the layout vai's CM kernels settled on). Cs16 stays a multiple
// of 16 bytes even when unused, so Bs behind it keeps the 16-byte alignment
// coopMatLoad needs: at 2 bytes NVIDIA read every B panel one element early.
shared float Cs32[accF32 == 1u ? subgroupCount * tileElements : tileElements];
shared float16_t Cs16[accF32 == 1u ? 8u : subgroupCount * tileElements];
shared float16_t Bs[panelK * wgN];

#define matA coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseA>
#define matB coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseB>
#define acc16 coopmat<float16_t, gl_ScopeSubgroup, tile, tile, gl_MatrixUseAccumulator>
#define acc32 coopmat<float, gl_ScopeSubgroup, tile, tile, gl_MatrixUseAccumulator>

// The workgroup's sequence within I, and within O and R.
uint seqInputBase = 0u;
uint seqOutputBase = 0u;

float readI(uint i)        { i += seqInputBase; return (typeI == DTYPE_F32) ? bufferI_f32[i] : float(bufferI_f16[i]); }
float readResidual(uint i) { i += seqOutputBase; return (typeI == DTYPE_F32) ? bufferRes_f32[i] : float(bufferRes_f16[i]); }
float readBias(uint c)     { return (hasBias == 0u) ? 0.0 : ((typeP == DTYPE_F32) ? bufferBias_f32[c] : float(bufferBias_f16[c])); }
void  writeO(uint i, float v) { i += seqOutputBase; if (typeO == DTYPE_F32) bufferO_f32[i] = v; else bufferO_f16[i] = float16_t(v); }

// The im2col element (k, t): k = ci * K + j, the input at t * stride + j - K/2.
float gatherInput(uint k, uint t)
{
    const uint c = k / K;
    const uint j = k - c * K;
    const int tIn = int(t * stride + j) - int(K >> 1u);
    return (tIn < 0 || tIn >= int(Ti)) ? 0.0 : readI(c * Ti + uint(tIn));
}

float finishOutput(uint channel, uint index, float value)
{
    value += readBias(channel);
    if (hasResidual == 1u && residualOrder == 1u) value += readResidual(index);
    value = applyActivation(value);
    if (hasResidual == 1u && residualOrder == 0u) value += readResidual(index);
    return value;
}

void fillB(uint panelBase, uint rawK, uint nBase)
{
    for (uint i = gl_LocalInvocationID.x; i < panelK * wgN; i += wgSize)
    {
        const uint kLocal = i / wgN;
        const uint nLocal = i - kLocal * wgN;
        const uint k = panelBase + kLocal;
        const uint t = nBase + nLocal;
        Bs[i] = float16_t((k < rawK && t < To) ? gatherInput(k, t) : 0.0);
    }
}

void main()
{
    seqInputBase = gl_WorkGroupID.z * Ci * Ti;
    seqOutputBase = gl_WorkGroupID.z * Co * To;

    const uint rawK = Ci * K;
    const uint paddedK = ((rawK + 15u) / 16u) * 16u;
    const uint kTiles = paddedK / 16u;
    const uint sgCountN = wgN / tile;
    const uint subgroupM = gl_SubgroupID / sgCountN;
    const uint subgroupN = gl_SubgroupID - subgroupM * sgCountN;
    const uint m0 = gl_WorkGroupID.y * wgM + subgroupM * tile;
    const uint n0 = gl_WorkGroupID.x * wgN + subgroupN * tile;
    const uint nBase = gl_WorkGroupID.x * wgN;
    const bool ownsRows = m0 < Co;   // uniform across the subgroup
    const uint aBase = (m0 / 16u) * kTiles * 256u;
    const uint sharedBase = gl_SubgroupID * tileElements;

    if (accF32 == 0u)
    {
        acc16 acc = acc16(float16_t(0.0));
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, nBase);
            barrier();
            if (ownsRows)
            {
                for (uint kLocal = 0u; kLocal < panelK && panelBase + kLocal < paddedK; kLocal += 16u)
                {
                    matA a;
                    matB b;
                    coopMatLoad(a, bufferW_f16, aBase + ((panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                    coopMatLoad(b, Bs, kLocal * wgN + subgroupN * tile, wgN, gl_CooperativeMatrixLayoutRowMajor);
                    acc = coopMatMulAdd(a, b, acc);
                }
            }
            barrier();
        }
        if (!ownsRows) return;
        coopMatStore(acc, Cs16, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < tileElements; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u, t = n0 + i % 16u;
            if (m < Co && t < To) writeO(m * To + t, finishOutput(m, m * To + t, float(Cs16[sharedBase + i])));
        }
    }
    else
    {
        acc32 acc = acc32(0.0);
        for (uint panelBase = 0u; panelBase < paddedK; panelBase += panelK)
        {
            fillB(panelBase, rawK, nBase);
            barrier();
            if (ownsRows)
            {
                for (uint kLocal = 0u; kLocal < panelK && panelBase + kLocal < paddedK; kLocal += 16u)
                {
                    matA a;
                    matB b;
                    coopMatLoad(a, bufferW_f16, aBase + ((panelBase + kLocal) / 16u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
                    coopMatLoad(b, Bs, kLocal * wgN + subgroupN * tile, wgN, gl_CooperativeMatrixLayoutRowMajor);
                    acc = coopMatMulAdd(a, b, acc);
                }
            }
            barrier();
        }
        if (!ownsRows) return;
        coopMatStore(acc, Cs32, sharedBase, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint i = gl_SubgroupInvocationID; i < tileElements; i += gl_SubgroupSize)
        {
            const uint m = m0 + i / 16u, t = n0 + i % 16u;
            if (m < Co && t < To) writeO(m * To + t, finishOutput(m, m * To + t, Cs32[sharedBase + i]));
        }
    }
}
