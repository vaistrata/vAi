/*=============================================================================
 linear-q8-input.comp: quantize a Linear's input to int8 for linear-q4-q8

     I fp32 or fp16 [M, K]  ->  Q int8 [M, K] + (d, sum q) per 32 elements

 One thread per 32-element group (row m, group g; gi = m * K/32 + g):
     d = max |I| / 127,  q = round(I / d) in [-127, 127],  I ~= d * q
 The group's bytes are 8 words at gi * 8. For each 8-element chunk c, word
 2c packs elements 0, 2, 4, 6 and word 2c + 1 elements 1, 3, 5, 7: the order
 in which a Q4 word's low and high nibbles come out under a 0x0F0F0F0F mask.
 (d, sum q) follow all the bytes, at vec2 index M * K / 8 + gi.

 Requirements: K % 32 == 0.
 Dispatch (host): (ceil(M * K / 32 / 64), 1, 1)
=============================================================================*/
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "common/spec_constants.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = SPEC_ID_TYPE_I) const uint typeI = 1;  // I (input) dtype: fp32 or fp16

layout(set = 0, binding = 0) writeonly buffer Q_BUF_U32 { uint bufferQ_u32[]; };    // the int8 bytes
layout(set = 0, binding = 0) writeonly buffer Q_BUF_V2  { vec2 bufferQ_v2[]; };     // (d, sum q), after them
layout(set = 0, binding = 1) readonly buffer I_BUF_4F32 { vec4 bufferI_4f32[]; };
layout(set = 0, binding = 1) readonly buffer I_BUF_4F16 { f16vec4 bufferI_4f16[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
};

// Four int8 values, low byte first.
uint pack4(ivec4 q)
{
    const uvec4 b = uvec4(q) & 0xFFu;
    return b.x | (b.y << 8) | (b.z << 16) | (b.w << 24);
}

void main()
{
    const uint gi = gl_GlobalInvocationID.x;
    if (gi >= M * (K / 32u)) return;

    vec4 x[8];
    [[unroll]] for (uint v = 0; v < 8u; v++)
        x[v] = (typeI == DTYPE_F32) ? bufferI_4f32[gi * 8u + v] : vec4(bufferI_4f16[gi * 8u + v]);

    vec4 peak = abs(x[0]);
    [[unroll]] for (uint v = 1; v < 8u; v++) peak = max(peak, abs(x[v]));
    const float amax = max(max(peak.x, peak.y), max(peak.z, peak.w));
    const float inv = (amax > 0.0) ? 127.0 / amax : 0.0;

    int sum = 0;
    [[unroll]] for (uint c = 0; c < 4u; c++)
    {
        const ivec4 lo = ivec4(round(x[2u * c] * inv));        // chunk elements 0..3
        const ivec4 hi = ivec4(round(x[2u * c + 1u] * inv));   // chunk elements 4..7
        sum += lo.x + lo.y + lo.z + lo.w + hi.x + hi.y + hi.z + hi.w;
        bufferQ_u32[gi * 8u + 2u * c]      = pack4(ivec4(lo.x, lo.z, hi.x, hi.z));   // elements 0, 2, 4, 6
        bufferQ_u32[gi * 8u + 2u * c + 1u] = pack4(ivec4(lo.y, lo.w, hi.y, hi.w));   // elements 1, 3, 5, 7
    }
    bufferQ_v2[M * K / 8u + gi] = vec2(amax / 127.0, float(sum));
}
