// =============================================================================
// zimage-attention-i8.comp: bidirectional flash attention for one fresh
//     sequence, with the Q·K dots on packed int8 dot products (Adreno)
//
//     O[n, h] = softmax(Q[h, n] · K[h, :]^T * scale) · V[:, h]
//
// zimage-attention-scalar.comp's frame (LPR = 4 lanes per query row, Br rows
// per workgroup, all N keys swept in Bc-wide tiles staged through shared
// memory a tile ahead), with the shared reads cut:
//   - K is quantized per key while it is staged: d = max|k| / 127 over the
//     key's Dh values (one subgroup butterfly over the Dh / 4 invocations
//     that stage it), stored as bytes k / d + 128 (so 4 dims per uint),
//     and d. The query row is quantized the same way once, in registers.
//   - a score is d_q * d_k * (sum dotPacked4x8EXT(q, k + 128) - 128 * sum q),
//     the mixed signed x unsigned form.
//   - V is staged as packed fp16 (uvec2 per 4 dims).
//   Online softmax in exp2 and the P·V sums stay fp32.
//
// - Q, K: [H, N, Dh] f16; V: [N, H*Dh] (typeV); O: [N, H*Dh] (typeO).
// - Dh = 128, Bc = 16 and 128 invocations are compile-time constants: as
//   specialization constants the Adreno 830 compiler leaves the loops rolled
//   and the kernel runs 2.3x slower (77 vs. 34 ms at N = 1056, 30 heads).
// - Requirements (host-checked): subgroups of at least Dh / 4 = 32,
//   N % Bc == 0, integerDotProduct (4x8 packed mixed).
// - Dispatch (host): .dispatch(ceil(N / Br), H).
// =============================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_integer_dot_product : require
#include "common/spec_constants.h"

const uint wgSize = 128u;               // = Br * LPR
const uint Dh     = 128u;               // head dim
const uint Bc     = 16u;                // keys per tile

layout(local_size_x = wgSize, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 4) const uint typeV  = 0;     // V dtype
layout(constant_id = SPEC_ID_TYPE_O) const uint typeO = 0;

layout(set = 0, binding = 0) writeonly buffer O_BUF_F32 { vec4 bufferO_f32[]; };            // [N, H*Dh]
layout(set = 0, binding = 0) writeonly buffer O_BUF_F16 { f16vec4 bufferO_f16[]; };
layout(set = 0, binding = 1) readonly buffer Q_BUF { f16vec4 bufferQ[]; };                  // [H, N, Dh]
layout(set = 0, binding = 2) readonly buffer K_BUF { f16vec4 bufferK[]; };                  // [H, N, Dh]
layout(set = 0, binding = 3) readonly buffer V_BUF_F32 { vec4 bufferV_f32[]; };             // [N, H*Dh]
layout(set = 0, binding = 3) readonly buffer V_BUF_F16 { f16vec4 bufferV_f16[]; };

layout(push_constant) uniform PushConstants {
    uint N;
    uint H;
    float scaleLog2;   // log2(e) / sqrt(Dh): softmax runs in exp2
};

const uint LPR = 4u;                    // lanes per query row
const uint Br  = wgSize / LPR;          // query rows per workgroup
const uint DH4 = Dh / 4u;               // head dim in vec4s
const uint T   = DH4 / LPR;             // vec4s per lane
const uint LD  = Bc * DH4 / wgSize;     // K (and V) vec4s staged per thread

shared uint  s_k[Bc * DH4];             // 4 dims of k / d + 128 per uint
shared float s_kd[Bc];                  // per-key scale d
shared uvec2 s_v[Bc * DH4];             // 4 dims of V as fp16

vec4 readV4(uint i) { return (typeV == 0u) ? bufferV_f32[i] : vec4(bufferV_f16[i]); }

float absMax(vec4 x) { x = abs(x); return max(max(x.x, x.y), max(x.z, x.w)); }

// The low bytes of r, r.x lowest.
uint packBytes(ivec4 r)
{
    const uvec4 b = uvec4(r) & 0xFFu;
    return b.x | (b.y << 8) | (b.z << 16) | (b.w << 24);
}

void main()
{
    const uint h    = gl_WorkGroupID.y;
    const uint tid  = gl_LocalInvocationIndex;
    const uint part = tid % LPR;
    const uint row  = gl_WorkGroupID.x * Br + tid / LPR;
    const bool inRange = row < N;

    // This lane's part of the query row, quantized with the row's scale.
    vec4 qf[T];
    float qMax = 0.0;
    [[unroll]] for (uint t = 0; t < T; ++t)
    {
        qf[t] = inRange ? vec4(bufferQ[(h * N + row) * DH4 + part + LPR * t]) * scaleLog2 : vec4(0.0);
        qMax = max(qMax, absMax(qf[t]));
    }
    qMax = max(qMax, subgroupShuffleXor(qMax, 1u));
    qMax = max(qMax, subgroupShuffleXor(qMax, 2u));
    const float qd = max(qMax, 1e-30) / 127.0;
    int q[T];
    int qSum = 0;                       // this lane's sum of q, for the k + 128 offset
    [[unroll]] for (uint t = 0; t < T; ++t)
    {
        const ivec4 r = ivec4(round(qf[t] * (1.0 / qd)));
        qSum += r.x + r.y + r.z + r.w;
        q[t] = int(packBytes(r));
    }
    const int qOffset = 128 * qSum;

    vec4 o[T];
    [[unroll]] for (uint t = 0; t < T; ++t) o[t] = vec4(0.0);
    float m = -1.0 / 0.0, l = 0.0;      // running max (log2 domain) / sum

    vec4 pk[LD], pv[LD];                // the next K / V tile, in flight
    [[unroll]] for (uint u = 0; u < LD; ++u)
    {
        const uint i = tid + u * wgSize, j = i / DH4, c = i % DH4;
        pk[u] = vec4(bufferK[(h * N + j) * DH4 + c]);
        pv[u] = readV4((j * H + h) * DH4 + c);
    }

    for (uint kv0 = 0; kv0 < N; kv0 += Bc)
    {
        barrier();   // previous tile's K/V reads done
        [[unroll]] for (uint u = 0; u < LD; ++u)
        {
            // The DH4 invocations staging key i / DH4 are aligned and adjacent.
            const uint i = tid + u * wgSize;
            float kMax = absMax(pk[u]);
            [[unroll]] for (uint x = 1u; x < DH4; x <<= 1)
                kMax = max(kMax, subgroupShuffleXor(kMax, x));
            kMax = max(kMax, 1e-30);
            s_k[i] = packBytes(ivec4(round(pk[u] * (127.0 / kMax))) + 128);
            if (i % DH4 == 0u)
                s_kd[i / DH4] = kMax / 127.0;
            s_v[i] = uvec2(packHalf2x16(pv[u].xy), packHalf2x16(pv[u].zw));
        }
        barrier();
        if (kv0 + Bc < N)
            [[unroll]] for (uint u = 0; u < LD; ++u)
            {
                const uint i = tid + u * wgSize, j = kv0 + Bc + i / DH4, c = i % DH4;
                pk[u] = vec4(bufferK[(h * N + j) * DH4 + c]);
                pv[u] = readV4((j * H + h) * DH4 + c);
            }

        // Scores of this tile (every lane of the row ends up with all of them).
        float s[Bc];
        float mx = -1.0 / 0.0;
        [[unroll]] for (uint j = 0; j < Bc; ++j)
        {
            int d = -qOffset;
            [[unroll]] for (uint t = 0; t < T; ++t)
                d += dotPacked4x8EXT(q[t], s_k[j * DH4 + part + LPR * t]);
            d += subgroupShuffleXor(d, 1u);
            d += subgroupShuffleXor(d, 2u);
            s[j] = float(d) * qd * s_kd[j];
            mx = max(mx, s[j]);
        }

        const float mNew = max(m, mx);
        const float alpha = exp2(m - mNew);
        l *= alpha;
        [[unroll]] for (uint t = 0; t < T; ++t) o[t] *= alpha;
        [[unroll]] for (uint j = 0; j < Bc; ++j)
        {
            const float p = exp2(s[j] - mNew);
            l += p;
            [[unroll]] for (uint t = 0; t < T; ++t)
            {
                const uvec2 v = s_v[j * DH4 + part + LPR * t];
                o[t] += p * vec4(unpackHalf2x16(v.x), unpackHalf2x16(v.y));
            }
        }
        m = mNew;
    }

    if (!inRange) return;
    const float inv = 1.0 / l;
    [[unroll]] for (uint t = 0; t < T; ++t)
    {
        const uint i = (row * H + h) * DH4 + part + LPR * t;
        if (typeO == 0u) bufferO_f32[i] = o[t] * inv;
        else             bufferO_f16[i] = f16vec4(o[t] * inv);
    }
}
